		A("Head",.5,.3,.4,0,.05,-.75) eyes(.15,-.95,.15,.1)
		for _,sx in {-1,1} do J("Arm"..(sx<0 and 1 or 2),.2,.2,.9,.4*sx,0,-.6,0,0,.45,col) A("Claw",.5,.2,.35,.55*sx,0,-1.4,dark) end
