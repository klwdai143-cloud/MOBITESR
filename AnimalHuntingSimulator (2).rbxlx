		A("Neck",.4,.4,.8,0,.5,-1.1,col,nil,nil,R(.4)) A("Head",.6,.5,.8,0,.85,-1.6,gr and WHITE or col) A("Snout",.4,.3,.5,0,.75,-2.1,gr and Color3.fromRGB(255,190,40) or light) eyes(.95,-1.85,.2,.14)
		legs(4,{-.3,.3},{-.7,.7},-.4,.28,.6)
		if not gr then for sx=-1,1,2 do A("Horn",.1,.5,.1,.2*sx,1.3,-1.5,acc,NEON,nil,R(-.4,0,-.2*sx)) end for i=1,5 do A("Spike",.15,.3,.2,0,.5,-.8+i*.35,acc,NEON,nil,R(.5)) end end
		wings(2.2,1.4,.45,.5,0,gr and Color3.fromRGB(240,200,120) or col:Lerp(acc,.4),NEON)
