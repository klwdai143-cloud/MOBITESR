ol><bool name="CanCollide">false</bool><float name="Transparency">0.4</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">3968255</Color3uint8><Vector3 name="size"><X>6.000</X><Y>1.000</Y><Z>6.000</Z></Vector3><CoordinateFrame name="CFrame"><X>165.000</X><Y>1.100</Y><Z>380.000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame></Properties></Item><Item class="Folder" referent="RBX101765"><Properties><string name="Name">Display</string></Properties></Item></Item></Item><Item class="SpawnLocation" referent="RBX102153"><Properties><string name="Name">SpawnLocation</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><float name="Transparency">1</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">16777215</Color3uint8><Vector3 name="size"><X>14.000</X><Y>1.000</Y><Z>14.000</Z></Vector3><CoordinateFrame name="CFrame"><X>0.000</X><Y>1.100</Y><Z>45.000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><bool name="Neutral">true</bool><int name="Duration">0</int></Properties></Item></Item><Item class="Lighting" referent="RBX3"><Properties><string name="Name">Lighting</string><token name="Technology">3</token></Properties></Item><Item class="ReplicatedStorage" referent="RBX7"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[local C={}
local function H(h) C.Codes={WELCOME={c=1000,g=25},HUNTER={c=5000,g=50},ANIMALS={g=100}}
return Color3.fromHex(h) end
C.Rar={"Common","Uncommon","Rare","Epic","Legendary","Mythic","Exotic","Secret","Celestial","Divine"}
C.RarCol={H"#9aa0ab",H"#46c846",H"#3282ff",H"#a046ff",H"#ffa01e",H"#eb323c",H"#1edce6",H"#e63ce6",H"#3c5aff",H"#ffd73c"}
C.HpMul={1,2,4,9,22,60,120,200,300,400}
C.IncMul={2,5,12,30,80,200,400,800,1600,3000}
C.ZR=100
C.Cap=10
C.Snd={
	shoot={"rbxasset://sounds/bass.wav",3,.5}, hit={"rbxasset://sounds/uuhhh.mp3",1.6,.4},
	caught={"rbxasset://sounds/electronicpingshort.wav",1.4,.7}, coin={"rbxasset://sounds/electronicpingshort.wav",2,.5},
	ui={"rbxasset://sounds/button.wav",1,.4}, reload={"rbxasset://sounds/switch.wav",1,.6},
	unlock={"rbxasset://sounds/bass.wav",.6,.9}, place={"rbxasset://sounds/clickfast.wav",1,.7}, Music=""}
local ZD={
{"Forest",0,1,1,"#2fbf4a","🌲",{{"Rabbit",1,"#f4f4f4",.8},{"Deer",2,"#b0713f",1.4},{"Fox",2,"#e8742a",1},{"Wolf",3,"#8a8f98",1.3},{"Boar",3,"#6b4a35",1.2},{"Bear",4,"#6b3f22",1.9},{"Tiger",4,"#e8962c",1.7},{"Elephant",5,"#8e949c",3},{"Gorilla",5,"#3e4250",2},{"Ancient Stag",6,"#7dff9a",1.8},{"Forest Dragon",6,"#2ea04d",2.4},{"Tree Titan",10,"#4b7a35",3.4}}},
{"Desert",5000,2.5,4,"#e8a030","🌵",{{"Fennec Fox",1,"#e6c79a",.8},{"Sand Snake",2,"#d8b04a",.8},{"Scorpion",2,"#2a2a2e",.9},{"Camel",3,"#c9a15a",2.2},{"Coyote",3,"#b98a5e",1.1},{"Ostrich",4,"#3a3340",1.9},{"Sand Golem",4,"#b8955a",2.4},{"Dune Shark",5,"#d5a85a",2.2},{"Sand Serpent",5,"#c4902f",1.6},{"Pharaoh Beast",6,"#3b6fd8",2.2},{"Sphinx",6,"#e0c070",2.6},{"Golden Anubis",10,"#f0c030",2.6}}},
{"Snow",50000,6,16,"#5cc8ff","❄️",{{"Snow Rabbit",1,"#ffffff",.8},{"Arctic Fox",2,"#eaf2ff",1},{"Snow Leopard",3,"#cfd8e8",1.5},{"Polar Bear",3,"#f2f6ff",2.2},{"Ice Wolf",3,"#a8c4ee",1.3},{"Ice Penguin",4,"#2a3040",1},{"Frost Bear",4,"#8fd8ff",2.1},{"Yeti",5,"#f0f4ff",2.8},{"Ice Dragon",6,"#4aa8ff",2.4},{"Frost Giant",6,"#6fb8ff",3},{"Glacier Phoenix",6,"#9fe6ff",1.8},{"Frost Titan",10,"#58d0ff",3.4}}},
{"Volcano",500000,15,64,"#ff5a1e","🌋",{{"Lava Bat",1,"#3a2a38",.8},{"Fire Lizard",2,"#ff6a2a",.9},{"Red Fox",2,"#e0401e",1},{"Molten Boar",3,"#5a2a20",1.3},{"Rock Golem",3,"#8a6a4a",2.4},{"Raptor",4,"#c84a2a",1.5},{"Fire Tiger",4,"#ff8a1e",1.8},{"Magma Dragon",5,"#e83a1a",2.6},{"Phoenix",6,"#ffb020",1.8},{"Inferno Golem",6,"#c8401e",3},{"Volcanic Titan",10,"#d03018",3.6}}},
{"Ocean",5000000,36,256,"#2a8ae8","🌊",{{"Clownfish",1,"#ff7a1e",.7},{"Sea Turtle",2,"#3fa860",1.4},{"Shark",3,"#7a8aa0",2.2},{"Dolphin",3,"#5a9ae0",1.8},{"Octopus",4,"#e0507a",1.5},{"Anglerfish",4,"#3a2a6a",1.4},{"Whale",5,"#3a7ad0",3.6},{"Leviathan",6,"#2a5ab0",3.2},{"Kraken",6,"#2a3a6a",3.4},{"Sea Dragon",6,"#2a7ad8",2.6},{"Poseidon",10,"#4ad0d0",3.4}}},
{"Sky",50000000,90,1024,"#7ac8ff","☁️",{{"Seagull",1,"#f2f2f2",.9},{"Eagle",2,"#6b4a2a",1.4},{"Hawk",2,"#b0713f",1.2},{"Owl",3,"#8a6a4a",1.1},{"Falcon",3,"#9a7a5a",1.2},{"Harpy",4,"#4a60b0",1.8},{"Griffin",4,"#d8a84a",2.2},{"Thunderbird",5,"#8a50c0",2.4},{"Sky Dragon",6,"#3a90e8",2.6},{"Cloud Titan",6,"#f0f4ff",3.4},{"Celestial Phoenix",10,"#ffd050",2}}},
}
local TY={{"Dragon","dragon"},{"Drake","dragon"},{"Griffin","dragon"},{"Leviathan","dragon"},{"Titan","golem"},{"Golem","golem"},{"Giant","golem"},{"Yeti","golem"},{"Gorilla","golem"},{"Poseidon","golem"},{"Kraken","octo"},{"Octopus","octo"},{"Serpent","snake"},{"Snake","snake"},{"Shark","fish"},{"Dolphin","fish"},{"Whale","fish"},{"Clownfish","fish"},{"Anglerfish","fish"},{"Turtle","turtle"},{"Penguin","penguin"},{"Scorpion","scorp"},{"Ostrich","ostrich"},{"Seagull","bird"},{"Eagle","bird"},{"Hawk","bird"},{"Owl","bird"},{"Falcon","bird"},{"Harpy","bird"},{"Thunderbird","bird"},{"Phoenix","bird"},{"Bat","bird"}}
C.Zones={}
C.A,C.AN={}, {}
for zi,r in ZD do
	local th=math.pi+.2+(zi-1)*.5488
	local z={Name=r[1],Cost=r[2],Hp=r[3],Inc=r[4],Col=H(r[5]),Emoji=r[6],Index=zi,List={},Center=Vector3.new(math.cos(th)*520,0,math.sin(th)*520)}
	table.insert(C.Zones,z)
	for _,e in r[7] do
		local a={Name=e[1],Rank=e[2],Col=H(e[3]),Size=e[4],Zone=z.Name,ZI=zi,Type="quad"}
		for _,t in TY do if a.Name:find(t[1]) then a.Type=t[2] break end end
		a.Hover=0
		if z.Name=="Sky" then a.Hover=9 elseif a.Type=="bird" and a.Name~="Seagull" then a.Hover=5 elseif a.Type=="bird" then a.Hover=6 elseif a.Type=="fish" then a.Hover=1.2 end
		a.Hp=math.floor(20*C.HpMul[a.Rank]*z.Hp) a.Inc=math.floor(C.IncMul[a.Rank]*z.Inc)
		table.insert(z.List,a) table.insert(C.A,a) C.AN[a.Name]=a
	end
end
local WL={ -- Name,Rank,Dmg,Rate,Mag,Reload,Range,Cost,Cur,Len,Hex
{"Pistol",1,10,2.5,12,1.2,130,0,"c",1.3,"#2b2d33"},{"Revolver",2,18,1.8,6,1.6,150,600,"c",1.5,"#3a3f3a"},
{"Combat Shotgun",3,36,1.4,8,1.8,160,6000,"c",2.4,"#2d3f66"},{"Plasma Rifle",4,70,4.5,30,2,190,50000,"c",2.8,"#40306a"},
{"Gold Rifle",5,130,5.5,30,2,210,400000,"c",2.8,"#d9a520"},{"Crimson Rifle",6,260,6.5,35,2.2,230,3000000,"c",3,"#7a1418"},
{"Crystal Sniper",7,520,3,10,2.4,300,250,"g",3.4,"#206070"},{"Void Sniper",8,1000,3.5,12,2.4,320,700,"g",3.4,"#4a1a60"},
{"Celestial Cannon",9,2000,4,15,2.6,340,1800,"g",3.6,"#1a2a80"},{"Divine Rifle",10,4200,5,20,2.6,360,5000,"g",3.6,"#e8c030"}}
C.W,C.WN={}, {}
for _,r in WL do local w={Name=r[1],Rank=r[2],Dmg=r[3],Rate=r[4],Mag=r[5],Reload=r[6],Range=r[7],Cost=r[8],Cur=r[9],Len=r[10],Hex=r[11]} table.insert(C.W,w) C.WN[w.Name]=w end
C.Up={{"Damage","💪",100,"+8% damage"},{"FireRate","⚡",150,"+4% fire rate"},{"Ammo","🔫",120,"+10% ammo"},{"Reload","🔄",120,"-2% reload time"},{"Range","🎯",100,"+5% range"},{"Crit","💥",200,"+1% crit chance"},{"Speed","👟",100,"+3% walk speed"}}
C.UpMax=50
function C.UpCost(base,l) return math.floor(base*1.35^l) end
C.Quests={
{t="hunt",g=10,txt="Hunt %d animals",rc=500,rg=10},{t="unique",g=5,txt="Discover %d new animals",rc=1500,rg=15},
{t="weapon",g=1,txt="Buy %d new weapon",rc=2000,rg=20},{t="place",g=3,txt="Place %d animals in your base",rc=3000,rg=20},
{t="upgrade",g=5,txt="Buy %d upgrades",rc=5000,rg=25},{t="coins",g=20000,txt="Collect %d coins",rc=8000,rg=30},
{t="zone",g=1,txt="Unlock %d new zone",rc=20000,rg=60}}
function C.Quest(qi) local n=#C.Quests local q=C.Quests[(qi-1)%n+1] local k=1+math.floor((qi-1)/n) return q,q.g*k,q.rc*k,q.rg*k end
C.Daily={{c=500},{g=50},{c=2500},{g=100},{c=10000},{g=200},{c=50000,g=500}}
C.Packs={{g=10,c=5000},{g=50,c=40000},{g=250,c=250000}}
C.Boosts={{"Coins","2x Coins (10 min)",30,"🪙"},{"Dmg","2x Damage (10 min)",30,"💥"}}
function C.SlotCost(k) return 250*3^(k-4) end
function C.RebCost(r) return 250000*4^r end
return C
]]></ProtectedString></Properties></Item><Item class="RemoteEvent" referent="RBX5"><Properties><string name="Name">Act</string></Properties></Item><Item class="RemoteEvent" referent="RBX6"><Properties><string name="Name">Push</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX13"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX10"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Models</string><ProtectedString name="Source"><![CDATA[local Cfg=require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))
local M={}
local SP,NEON=Enum.Material.SmoothPlastic,Enum.Material.Neon
local BALL,CYL=Enum.PartType.Ball,Enum.PartType.Cylinder
local function mk(par,name,size,col,mat,shape)
	local p=Instance.new("Part") p.Name=name p.Size=size p.Color=col p.Material=mat or SP
	p.CanCollide=false p.Massless=true p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth
	if shape then p.Shape=shape end p.Parent=par return p
end
local function weld(a,b,c0,c1) local w=Instance.new("Weld") w.Name="W" w.Part0=a w.Part1=b w.C0=c0 w.C1=c1 or CFrame.new() w.Parent=b return w end
local function emitter(par,col,size,rate,spd)
	local e=Instance.new("ParticleEmitter") e.Color=ColorSequence.new(col) e.LightEmission=1 e.Rate=rate
	e.Size=NumberSequence.new(size,0) e.Lifetime=NumberRange.new(1,1.6) e.Speed=NumberRange.new(1,spd or 3)
	e.SpreadAngle=Vector2.new(180,180) e.Transparency=NumberSequence.new(.2,1) e.Parent=par return e
end
local BLACK,WHITE=Color3.new(0,0,0),Color3.new(1,1,1)
function M.Animal(d,scale,label)
	local s=d.Size*(scale or 1) local N=d.Name local ty=d.Type
	local col=d.Col local dark=col:Lerp(BLACK,.35) local light=col:Lerp(WHITE,.45) local acc=Cfg.RarCol[d.Rank]
	local m=Instance.new("Model") m.Name=N
	local body=mk(m,"Body",Vector3.new(1,1,1),col) body.Anchored=true m.PrimaryPart=body
	local function R(a,b,c) return CFrame.Angles(a or 0,b or 0,c or 0) end
	local function A(n,w,h,l,x,y,z,c,mat,shape,cf)
		local p=mk(m,n,Vector3.new(w*s,h*s,l*s),c or col,mat,shape) local off=CFrame.new(x*s,y*s,z*s)*(cf or CFrame.new()) p.CFrame=body.CFrame*off weld(body,p,off) return p
