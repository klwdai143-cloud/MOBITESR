		for _,sx in {-1,1} do local p=J(sx<0 and "WingL" or "WingR",.6,.06,.4,.35*sx,-.1,-.4,-sx*.3,0,0,dark) p:SetAttribute("S",sx) end
		if dol then A("Beak",.25,.2,.6,0,-.05,-1.2,light) end
		if sh then for i=-1,1 do A("Tooth",.06,.08,.06,i*.12,-.15,-.9,WHITE) end end
		if cl then for i=-1,1 do A("Band",.82,.82,.1,0,0,i*.55,WHITE,nil,BALL) end end
		if ang then A("Lure",.04,.6,.04,0,.6,-.7,dark) A("Bulb",.2,.2,.2,0,1,-.8,Color3.fromRGB(255,240,100),NEON,BALL) for i=-2,2 do A("Tooth",.06,.15,.06,i*.1,-.25,-.85,WHITE) end end
		if wh then A("Spout",.1,.5,.1,0,.6,-.4,Color3.fromRGB(180,230,255),NEON) end
	elseif ty=="turtle" then
		body.Size=Vector3.new(1.3*s,.35*s,1.6*s) H=.35 body.Color=light
		A("Shell",1.3,.8,1.6,0,.3,0,col,nil,BALL) A("Head",.4,.4,.5,0,.1,-1,light,nil,BALL) eyes(.2,-1.2,.15,.08)
		local i=0 for _,zz in {-.5,.5} do for _,xx in {-.7,.7} do i+=1 J("Leg"..i,.5,.1,.35,xx,0,zz,-xx*.4,0,0,light) end end
	elseif ty=="octo" then
		body.Size=Vector3.new(1*s,1*s,1*s) body.Shape=BALL H=1.1 body.Position=Vector3.zero
		A("Mantle",.8,1,.8,0,.5,.3,col,nil,BALL) eyes(.1,-.45,.3,.2) A("Pupil",.1,.1,.1,.3,.1,-.55,BLACK) A("Pupil",.1,.1,.1,-.3,.1,-.55,BLACK)
		local n=8 for i=1,n do local a=i/n*6.283 J("Leg"..i,.2,.9,.2,math.cos(a)*.3,-.4,math.sin(a)*.3,0,.45,0,dark,nil,nil,CFrame.Angles(math.sin(a)*.5,0,-math.cos(a)*.5)) end
		if N:find("Kraken") then for i=1,5 do A("Spike",.12,.5,.12,(i-3)*.2,.95,.2,acc,NEON) end end
	elseif ty=="snake" then
		body.Size=Vector3.new(.55*s,.5*s,.9*s) body.Shape=BALL H=.3
		eyes(.15,-.4,.18,.1) A("Tongue",.05,.02,.35,0,-.1,-.65,Color3.fromRGB(255,80,120))
		for i=1,7 do J("Seg"..i,.5-i*.03,.45-i*.03,.55,0,-.02,.35+i*.45,0,0,-.2,i%2==0 and light or col,nil,BALL) end
