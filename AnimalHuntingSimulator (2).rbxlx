		if tree then for i=1,4 do A("Leaf",.6,.5,.6,(i-2.5)*.35,1.6,0,Color3.fromRGB(70,170,70),nil,BALL) end end
		if N:find("Cloud") then for i=1,5 do A("Cloud",.7,.5,.7,(i-3)*.4,1.5,0,WHITE,nil,BALL) end end
		if pos then A("Staff",.1,2.4,.1,1.2,.3,-.5,Color3.fromRGB(255,210,60),NEON) for i=-1,1 do A("Prong",.08,.5,.08,1.2+i*.2,1.7,-.5,Color3.fromRGB(90,255,255),NEON) end A("Crown",.7,.2,.7,0,1.55,-.1,Color3.fromRGB(255,210,60),NEON) A("Beard",.4,.5,.1,0,.8,-.45,WHITE) end
	elseif ty=="dragon" then
		body.Size=Vector3.new(.9*s,.8*s,2*s) H=1
