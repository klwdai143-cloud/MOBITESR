		if not bat then legs(2,{-.18,.18},{.1},-.35,.12,.5,Color3.fromRGB(255,190,40)) else H=.4 end
	elseif ty=="ostrich" then
		body.Size=Vector3.new(.8*s,.8*s,1.2*s) H=1.75
		A("Neck",.2,1.3,.2,0,.9,-.5) A("Head",.35,.3,.4,0,1.6,-.6) A("Beak",.12,.1,.3,0,1.55,-.9,Color3.fromRGB(255,180,100)) eyes(1.65,-.75,.14,.08)
		J("Tail",.6,.5,.6,0,.3,.6,0,0,-.3,WHITE,nil,BALL) wings(.5,.5,.4,.2,0,WHITE) legs(2,{-.2,.2},{0},-.4,.14,1.35,Color3.fromRGB(255,170,150))
