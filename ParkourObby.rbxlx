me="Anchored">true</bool><Color3uint8 name="Color3uint8">4294956800</Color3uint8><CoordinateFrame name="CFrame"><X>0</X><Y>17</Y><Z>-335</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>20</X><Y>1</Y><Z>20</Z></Vector3></Properties></Item></Item>
<Item class="ServerScriptService" referent="RBX37"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX38"><Properties><string name="Name">ObbyServer</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TOTAL_STAGES = 25

Players.PlayerAdded:Connect(function(player)
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = player
	local stage = Instance.new("IntValue"); stage.Name = "Stage"; stage.Value = 0; stage.Parent = ls
	local wins = Instance.new("IntValue"); wins.Name = "Wins"; wins.Value = 0; wins.Parent = ls
end)

local function getPlayer(hit)
	local char = hit.Parent
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then return Players:GetPlayerFromCharacter(char), hum end
end

local cooldown = {}
for _, p in ipairs(workspace:GetDescendants()) do
	if p:IsA("BasePart") then
		if p.Name == "Kill" then
			p.Touched:Connect(function(hit)
				local _, hum = getPlayer(hit)
				if hum then hum.Health = 0 end
			end)
		elseif p.Name:match("^Checkpoint_") then
			local num = tonumber(p.Name:match("%d+"))
			p.Touched:Connect(function(hit)
				local plr = getPlayer(hit)
				if plr and plr:FindFirstChild("leaderstats") and plr.leaderstats.Stage.Value < num then
					plr.leaderstats.Stage.Value = num
					plr.RespawnLocation = p
				end
			end)
		elseif p.Name == "Finish" then
			p.Touched:Connect(function(hit)
				local plr = getPlayer(hit)
				if plr and not cooldown[plr] then
					cooldown[plr] = true
					plr.leaderstats.Wins.Value += 1
					plr.leaderstats.Stage.Value = TOTAL_STAGES
					task.delay(5, function() cooldown[plr] = nil end)
				end
			end)
		end
	end
end
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX39"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX40"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX41"><Properties><string name="Name">ObbyGui</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ✏️ غيّر رقم الموسيقى هنا / change the music id here
local MUSIC_ID = "rbxassetid://1837879082"

local music = Instance.new("Sound")
music.Name = "ObbyMusic"; music.SoundId = MUSIC_ID
music.Looped = true; music.Volume = 0.4
music.Parent = game:GetService("SoundService")
music:Play()

local gui = Instance.new("ScreenGui")
gui.Name = "ObbyGui"; gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 100)
frame.Position = UDim2.new(0, 10, 0, 10)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
frame.BackgroundTransparency = 0.25
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local function label(y, text)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -16, 0, 26); l.Position = UDim2.new(0, 8, 0, y)
	l.BackgroundTransparency = 1; l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamBold; l.TextSize = 18
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Text = text; l.Parent = frame
	return l
end
local stageL = label(6, "Stage: 0 / 25")
local timeL = label(36, "Time: 0:00")
local winsL = label(66, "Wins: 0")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 110, 0, 34); btn.Position = UDim2.new(0, 10, 0, 118)
btn.BackgroundColor3 = Color3.fromRGB(60, 160, 255); btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold; btn.TextSize = 16; btn.Text = "🎵 Music: ON"
btn.Parent = gui
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
btn.MouseButton1Click:Connect(function()
	if music.Playing then music:Pause(); btn.Text = "🔇 Music: OFF"
	else music:Resume(); btn.Text = "🎵 Music: ON" end
end)

local start = os.clock()
task.spawn(function()
	while true do
		local t = math.floor(os.clock() - start)
		timeL.Text = string.format("Time: %d:%02d", t // 60, t % 60)
		task.wait(1)
	end
end)

local ls = player:WaitForChild("leaderstats")
local stage, wins = ls:WaitForChild("Stage"), ls:WaitForChild("Wins")
local function refresh()
	stageL.Text = "Stage: " .. stage.Value .. " / 25"
	winsL.Text = "Wins: " .. wins.Value
end
stage.Changed:Connect(refresh); wins.Changed:Connect(refresh); refresh()
wins.Changed:Connect(function() start = os.clock() end)
]]></ProtectedString></Properties></Item></Item></Item>
