local base=Win("base","My Base","🏠",420,300)
local baseT=lbl(base,"",20,{Size=UDim2.new(1,0,0,130),TextWrapped=true})
local b1=btn(base,"🏠 Teleport to Base",18,GREEN,{Size=UDim2.new(1,-40,0,46),Position=UDim2.fromOffset(20,150)}) b1.Activated:Connect(function() Act:FireServer("TP","Base") end)
local b2=btn(base,"💰 Collect Earnings",18,GOLD,{Size=UDim2.new(1,-40,0,46),Position=UDim2.fromOffset(20,205)}) b2.Activated:Connect(function() Act:FireServer("Collect") end)
Rf.base=function() local pl=0 for _ in S.Placed do pl+=1 end baseT.Text="Pedestals: "..S.Slots.."/12\nAnimals placed: "..pl.."\nIncome: 🪙 "..fmt(S.Inc).." / sec\nWaiting: 🪙 "..fmt(S.Pending) end
-- HUD
local tl=N("Frame",{Size=UDim2.fromOffset(200,330),Position=UDim2.fromOffset(10,10),BackgroundTransparency=1},gui) local tls=N("UIScale",{},tl)
local rt=N("Frame",{Size=UDim2.fromOffset(60,270),Position=UDim2.new(1,-70,.5,-135),BackgroundTransparency=1},gui) local rts=N("UIScale",{},rt)
local bc=N("Frame",{Size=UDim2.fromOffset(230,46),AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-18),BackgroundTransparency=1},gui) local bcs=N("UIScale",{},bc)
local function pill(y,icon,col,plus)
	local f=N("Frame",{Size=UDim2.fromOffset(190,40),Position=UDim2.fromOffset(0,y),BackgroundColor3=RGB(26,34,70)},tl) rd(f,20) st(f,RGB(70,100,200),2)
	lbl(f,icon,24,{Size=UDim2.fromOffset(40,40),Position=UDim2.fromOffset(2,0)})
	local t=lbl(f,"0",22,{Size=UDim2.new(1,-90,1,0),Position=UDim2.fromOffset(44,0),TextXAlignment=Enum.TextXAlignment.Left,TextColor3=col})
	if plus then local p=btn(f,"+",22,GREEN,{Size=UDim2.fromOffset(32,32),Position=UDim2.new(1,-36,.5,-16)}) p.Activated:Connect(function() shopTab=plus Open("shop") end) end
	return t,f
end
local coinT,coinF=pill(0,"🪙",GOLD,"Weapons") local gemT=pill(46,"💎",RGB(210,120,255),"Coins") local animT=pill(92,"🐾",WHITE)
local function menuBtn(par,x,y,icon,text,col,id,w,h)
	local b=N("TextButton",{Text="",Size=UDim2.fromOffset(w,h),Position=UDim2.fromOffset(x,y),BackgroundColor3=col},par) rd(b,10) st(b,col:Lerp(Color3.new(0,0,0),.5),3)
	lbl(b,icon,h>60 and 30 or 28,{Size=UDim2.new(1,0,.65,0)}) lbl(b,text,12,{Size=UDim2.new(1,0,.3,0),Position=UDim2.fromScale(0,.68)})
	b.Activated:Connect(function() Sfx("ui") Open(id) end) return b
end
for i,m in {{"🛒","Shop",GOLD,"shop"},{"⬆️","Upgrades",BLUE,"up"},{"📖","Index",RGB(70,130,220),"idx"},{"🎁","Rewards",RED,"rw"},{"🔄","Rebirth",PURP,"reb"},{"⚙️","Settings",RGB(60,150,240),"set"}} do
	menuBtn(tl,((i-1)%3)*66,140+((i-1)//3)*74,m[1],m[2],m[3],m[4],62,68)
end
for i,m in {{"🎒","Items",RGB(60,170,90),"inv"},{"📍","Zones",RGB(230,120,40),"zn"},{"🏠","Base",RGB(60,150,240),"base"},{"📜","Quest",RGB(190,150,60),"qst"}} do
	menuBtn(rt,0,(i-1)*68,m[1],m[2],m[3],m[4],60,62)
end
local ammoF=N("Frame",{Size=UDim2.fromOffset(170,44),BackgroundColor3=RGB(26,34,70),Visible=false},bc) rd(ammoF,12) st(ammoF,RGB(70,100,200),2)
local ammoT=lbl(ammoF,"🔫 0/0",22,{Size=UDim2.fromScale(1,1)})
local relB=btn(bc,"🔄",24,BLUE,{Size=UDim2.fromOffset(50,44),Position=UDim2.fromOffset(178,0)}) relB.Activated:Connect(function() Act:FireServer("Reload") end)
local function fit() local v=gui.AbsoluteSize local s=math.clamp(v.Y/700,.62,1.1) tls.Scale=s rts.Scale=s bcs.Scale=s end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit) fit()
-- TOASTS / BANNER / FX UI
local toastF=N("Frame",{Size=UDim2.fromOffset(340,200),AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,14),BackgroundTransparency=1},gui) N("UIListLayout",{Padding=UDim.new(0,6),HorizontalAlignment=Enum.HorizontalAlignment.Center},toastF)
local function toast(text,col)
	local f=N("Frame",{Size=UDim2.fromOffset(320,40),BackgroundColor3=RGB(26,30,64)},toastF) rd(f,12) st(f,col or RGB(120,100,255),2)
	lbl(f,text,16,{Size=UDim2.fromScale(1,1),TextWrapped=true,TextColor3=col or WHITE})
	task.delay(3,function() TS:Create(f,TweenInfo.new(.4),{BackgroundTransparency=1}):Play() for _,c in f:GetDescendants() do if c:IsA("TextLabel") then TS:Create(c,TweenInfo.new(.4),{TextTransparency=1,TextStrokeTransparency=1}):Play() end end task.wait(.45) f:Destroy() end)
	if #toastF:GetChildren()>6 then toastF:GetChildren()[2]:Destroy() end
end
local function banner(t1,t2,col)
	local f=N("Frame",{Size=UDim2.fromOffset(420,110),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.3),BackgroundColor3=col:Lerp(RGB(20,10,10),.55)},gui) rd(f,18) st(f,col,4)
	local sc=N("UIScale",{Scale=0},f) lbl(f,t1,32,{Size=UDim2.new(1,0,.55,0),TextColor3=GOLD}) lbl(f,t2,24,{Size=UDim2.new(1,0,.4,0),Position=UDim2.fromScale(0,.55),TextColor3=col})
	TS:Create(sc,TweenInfo.new(.4,Enum.EasingStyle.Back),{Scale=math.min(1,gui.AbsoluteSize.X/460)}):Play()
	task.delay(3.2,function() TS:Create(sc,TweenInfo.new(.25),{Scale=0}):Play() task.wait(.3) f:Destroy() end)
end
local function coinFly(n)
	Sfx("coin") if n<=0 then return end
	local c=coinF.AbsolutePosition+Vector2.new(24,20)
	for i=1,8 do task.delay(i*.05,function()
		local l=lbl(gui,"🪙",28,{Size=UDim2.fromOffset(34,34),Position=UDim2.fromScale(.5,.6),AnchorPoint=Vector2.new(.5,.5),TextStrokeTransparency=1})
		local t=TS:Create(l,TweenInfo.new(.6,Enum.EasingStyle.Quad),{Position=UDim2.fromOffset(c.X,c.Y)}) t:Play() t.Completed:Once(function() l:Destroy() end)
	end) end
end
-- WORLD FX
local function fxPart(pos) return N("Part",{Anchored=true,CanCollide=false,CanQuery=false,Transparency=1,Size=Vector3.one*.5,Position=pos},workspace) end
local function burst(pos,col,n,size)
	local p=fxPart(pos) local e=N("ParticleEmitter",{Color=ColorSequence.new(col),Size=NumberSequence.new(size,0),Lifetime=NumberRange.new(.5,1),Speed=NumberRange.new(10,22),SpreadAngle=Vector2.new(360,360),Rate=0,LightEmission=1,Transparency=NumberSequence.new(0,1)},p)
	e:Emit(n) Debris:AddItem(p,1.5)
end
local function tracer(a,b,col)
	local d=(b-a).Magnitude if d<1 then return end
	local p=N("Part",{Anchored=true,CanCollide=false,CanQuery=false,Material=Enum.Material.Neon,Color=col,Size=Vector3.new(.15,.15,d),CFrame=CFrame.lookAt(a:Lerp(b,.5),b)},workspace)
	TS:Create(p,TweenInfo.new(.12),{Transparency=1}):Play() Debris:AddItem(p,.15)
end
local function dmgPop(pos,n,crit)
	local p=fxPart(pos+Vector3.new(math.random(-10,10)/10,1,0))
	local bb=N("BillboardGui",{Size=UDim2.fromOffset(100,40),AlwaysOnTop=true,StudsOffset=Vector3.new(0,0,0)},p)
	local t=lbl(bb,(crit and "💥 " or "")..fmt(n),crit and 28 or 22,{Size=UDim2.fromScale(1,1),TextColor3=crit and RGB(255,220,50) or WHITE})
	TS:Create(bb,TweenInfo.new(.8),{StudsOffset=Vector3.new(0,4,0)}):Play() TS:Create(t,TweenInfo.new(.8),{TextTransparency=1,TextStrokeTransparency=1}):Play() Debris:AddItem(p,.9)
end
local function flash()
	local f=N("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=WHITE,BackgroundTransparency=0,ZIndex=50},gui) local t=TS:Create(f,TweenInfo.new(1.2),{BackgroundTransparency=1}) t:Play() t.Completed:Once(function() f:Destroy() end)
end
-- SHOOTING
local tool,holding,ammo,mag,reloading,lastFire=nil,false,0,0,false,0
local function setAmmo() ammoT.Text="🔫 "..ammo.."/"..mag ammoF.Visible=tool~=nil relB.Visible=tool~=nil end
local function nearestAnimal()
	local c=lp.Character local r=c and c:FindFirstChild("HumanoidRootPart") local f=workspace:FindFirstChild("Animals") if not r or not f or not S then return end
	local best,bd=nil,S.St.rng
	for _,m in f:GetChildren() do local b=m.PrimaryPart if b and S.Zones[m:GetAttribute("Zone")] then local d=(b.Position-r.Position).Magnitude if d<bd then best,bd=b.Position,d end end end
	return best
end
local function fire(tgt)
	local c=lp.Character local head=c and c:FindFirstChild("Head") if not head or not tool or not S then return end
	local now=os.clock() if now-lastFire<1/S.St.rate or reloading then return end
	if ammo<=0 then Act:FireServer("Reload") return end
	lastFire=now ammo-=1 setAmmo()
	local dir=tgt-head.Position Act:FireServer("Shoot",dir)
	local rng=S.St.rng local endp=head.Position+dir.Unit*math.min(dir.Magnitude,rng)
	local m=tool:FindFirstChild("Muzzle",true) local o=m and m.WorldPosition or head.Position
	local w=Cfg.WN[S.Equipped] tracer(o,endp,Cfg.RarCol[w.Rank]) burst(o,Cfg.RarCol[w.Rank],4,.6) Sfx("shoot")
end
local function hook(c)
	c.ChildAdded:Connect(function(t) if t:IsA("Tool") then tool=t setAmmo() t.Activated:Connect(function() holding=true end) t.Deactivated:Connect(function() holding=false end) end end)
	c.ChildRemoved:Connect(function(t) if t==tool then tool=nil holding=false setAmmo() end end)
end
lp.CharacterAdded:Connect(hook)
if lp.Character then hook(lp.Character) for _,t in lp.Character:GetChildren() do if t:IsA('Tool') then tool=t t.Activated:Connect(function() holding=true end) t.Deactivated:Connect(function() holding=false end) end end end
task.spawn(function() while true do task.wait()
	if tool and S then
		if opts.Auto then local t=nearestAnimal() if t then fire(t) end elseif holding then fire(mouse.Hit.Position) end
	end
end end)
-- PUSH
Push.OnClientEvent:Connect(function(k,a,b,c,d,e)
	if k=="State" then
		local first=S==nil S=a
		if first then for o,v in S.Opts do opts[o]=v end applyOpts() end
		coinT.Text=fmt(S.Coins) gemT.Text=fmt(S.Gems)
		local n=#S.Animals for _ in S.Placed do n+=1 end animT.Text=tostring(n)
		if cur and Rf[cur] then Rf[cur]() end
	elseif k=="Notify" then toast(a,b)
	elseif k=="Ammo" then ammo,mag=a,b setAmmo()
	elseif k=="Reload" then reloading=true ammoT.Text="Reloading..." Sfx("reload") task.delay(a,function() reloading=false setAmmo() end)
	elseif k=="Tracer" then tracer(a,b,c) Sfx("shoot")
	elseif k=="Hit" then dmgPop(a,b,c) Sfx("hit") burst(a,WHITE,6,.4)
	elseif k=="Caught" then
		local col=Cfg.RarCol[b] burst(e,col,40,1) Sfx("caught")
		toast("You caught "..a.." ["..Cfg.Rar[b].."]"..(c>0 and ("  +💎"..c) or "")..(d and "  NEW!" or ""),col)
	elseif k=="Coin" then coinFly(a)
	elseif k=="Sfx" then Sfx(a)
	elseif k=="ZoneUnlocked" then local z for _,zz in Cfg.Zones do if zz.Name==a then z=zz end end Sfx("unlock") banner("New Zone Unlocked!",z.Emoji.." "..a.." Zone",z.Col)
	elseif k=="Rebirth" then flash() Sfx("unlock") banner("REBIRTH!","x"..(a+1).." coin multiplier",PURP) end
end)
-- music
if Cfg.Snd.Music~="" then musicS=N("Sound",{SoundId=Cfg.Snd.Music,Looped=true,Volume=.3},SndS) musicS:Play() end
-- gates unlocked locally
task.spawn(function() while true do task.wait(1.5)
	local g=workspace:FindFirstChild("Gates")
	if g and S then for _,m in g:GetChildren() do
		local b=m:FindFirstChild("Barrier") local z=Cfg.Zones[m:GetAttribute("Zone")]
		if b and z and S.Zones[z.Name] then b.CanCollide=false b.Transparency=1 local pr=b:FindFirstChild("Prompt") if pr then pr.Enabled=false end end
	end end
	if cur=="rw" or cur=="shop" then if S then Rf[cur]() end end
end end)
-- lava glow
local function lava(p) TS:Create(p,TweenInfo.new(1.2+math.random(),Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{Color=RGB(255,60,10)}):Play() end
for _,p in CS:GetTagged("Lava") do lava(p) end CS:GetInstanceAddedSignal("Lava"):Connect(lava)
-- animal animation
local anims={}
local function reg(m)
	local legs={} for i=1,4 do local l=m:WaitForChild("Leg"..i,5) local w=l and l:FindFirstChild("W") if w then legs[i]={w=w,c0=w.C0} end end
	anims[m]={legs=legs,ph=math.random()*6}
	m:GetAttributeChangedSignal("Hit"):Connect(function()
		local h=N("Highlight",{FillColor=WHITE,FillTransparency=.3,OutlineTransparency=1,DepthMode=Enum.HighlightDepthMode.Occluded},m) Debris:AddItem(h,.15)
	end)
end
task.spawn(function()
	local f=workspace:WaitForChild("Animals")
	for _,m in f:GetChildren() do task.spawn(reg,m) end
	f.ChildAdded:Connect(function(m) task.spawn(reg,m) end) f.ChildRemoved:Connect(function(m) anims[m]=nil end)
end)
RunS.RenderStepped:Connect(function()
	local cam=workspace.CurrentCamera local t=os.clock()
	for m,a in anims do
		local b=m.PrimaryPart
		if b and (b.Position-cam.CFrame.Position).Magnitude<160 then
			local s=m:GetAttribute("State") local f=s=="Run" and 13 or s=="Walk" and 6 or 0
			for i,l in a.legs do
				local ang=0
				if f>0 then ang=math.sin(t*f+a.ph+((i==1 or i==4) and 0 or math.pi))*.7 elseif s=="Alert" and i<=2 then ang=-.5 end
				l.w.C0=l.c0*CFrame.Angles(ang,0,0)
			end
		end
	end
end)
