local function getData(p) return DATA[p] end
local function pack(p)
 local d=DATA[p]; if not d then return end
 local counts={}; for n,c in pairs(d.Animals) do counts[n]=c end
 return {Coins=d.Coins,Gems=d.Gems,Animals=counts,Placed=d.Placed,Weapons=d.Weapons,Equipped=d.Equipped,DamageLevel=d.DamageLevel,Rebirth=d.Rebirth,OpenZones=d.OpenZones,Index=d.Index,Kills=d.Kills,Pending=d.Pending}
