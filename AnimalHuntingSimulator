local function spawnAnimal(name)
 local def=ANIMALS[name]; if not def then return end; local c=ZONES[def.zone].center
 local pos=Vector3.new(c.X+math.random(-55,55),1,c.Z+math.random(-55,55)); local m=makeAnimal(name,def.zone,pos)
 task.spawn(function()
  while m.Parent do
   task.wait(math.random(3,7)); if not m.Parent then break end
   local from=m:GetPivot(); local dest=from*CFrame.new(math.random(-18,18),0,math.random(-18,18))*CFrame.Angles(0,math.rad(math.random(-100,100)),0)
   for s=1,20 do if not m.Parent then break end; m:PivotTo(from:Lerp(dest,s/20)*CFrame.new(0,math.sin(s/20*math.pi)*.18,0)); task.wait(.05) end
  end
 end)
 return m
end
for name in pairs(ANIMALS) do for i=1,2 do spawnAnimal(name) end end
