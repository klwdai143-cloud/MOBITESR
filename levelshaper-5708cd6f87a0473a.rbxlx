		<Item class="ModuleScript" referent="RBX0000000000000000000000000000133D">
			<Properties>
				<string name="Name">GameConfig</string>
				<ProtectedString name="Source"><![CDATA[-- Generated by LevelShaper. Edit freely: every script reads its numbers from here.
return {
	-- Game name shown in the HUD and on signs
	Title = "محاكي صيد الحيوانات",
	-- Which LevelShaper template this is — the scripts read it, don't change it
	Genre = "Steal",
	-- Every player-facing text. Reword or translate freely; keep the {placeholders}
	Strings = {
		intro = "Buy {creature}s on the runway, bring them home and steal rare ones from other bases!",
		base_sign = "قاعدة {player}",
		base_free = "قاعدة متاحة",
		base_yours = "This is your base! {creature}s you buy walk here.",
		intro_base = "Your base is #{n} - follow the golden arrow!",
		base_mark = "YOUR BASE #{n}",
		base_arrow = "Your base #{n} - {m}m",
		bases_full = "Every base is taken. Wait for a free one!",
		buy = "جمع",
		gone = "سبقك لاعب آخر!",
		spin = "Spin",
		seeds = "Buy seeds",
		rolled = "You got {name}!",
		planted = "Planted a seed! It grows in {t}",
		grown = "{name} is ready!",
		growing = "Growing {t}",
		price = "{n} {cash}",
		income = "+{n} {cash}/ث",
		need_more = "تحتاج إلى {n} {cash} إضافية",
		base_full = "Your base is full! Sell a {creature} first.",
		bought = "حصلت على {name}!",
		steal = "Steal",
		sell = "Sell for {n}",
		sold = "Sold {name} for {n} {cash}",
		stealing = "Run home with {name}!",
		stolen = "You stole {name}!",
		robbed = "{player} is stealing your {name}!",
		lost = "{player} stole your {name}!",
		returned = "{name} went back home",
		tagged = "Tagged! {name} went back home",
		carrying = "Already carrying something",
		collect = "اجمع",
		collected = "+{n} {cash}",
		lock = "إغلاق القاعدة",
		locked = "القاعدة مغلقة لمدة {t}",
		lock_ready = "Lock ready in {t}",
		base_locked = "هذه القاعدة مغلقة!",
		hud_income = "{n} {cash}/ث",
		stat_steals = "Steals",
		rarity_common = "شائع",
		rarity_rare = "نادر",
		rarity_epic = "ملحمي",
		rarity_legendary = "أسطوري",
		rarity_mythic = "أسطوري خارق",
		mut_golden = "Golden",
		mut_diamond = "Diamond",
		mut_rainbow = "Rainbow",
		storm_start = "Mutation storm! Mutations are 5x more likely for {t}",
		storm_end = "The mutation storm is over",
		storm_hud = "Mutation storm {t}",
		upgrade_action = "تطوير القاعدة",
		upgrade = "الطابق التالي: {n} {cash}",
		upgraded = "أصبحت قاعدتك في المستوى {n}!",
		level_label = "مستوى القاعدة {n}/{max}",
		max_level = "أقصى مستوى",
		index = "الفهرس",
		index_title = "الفهرس {n}/{total}",
		unknown = "؟؟؟",
		chance = "{p}%",
		wild_intro = "Sneak into the zones, grab a {creature} and run home before the guards catch you!",
		wild_grab = "جمع",
		wild_grabbed = "أحضر {name} إلى قاعدتك!",
		wild_caught = "أعاد الحارس {name} إلى مكانه.",
		wild_guard = "حارس",
		wild_speed = "الركض أسرع",
		wild_speed_price = "السرعة {n}/{max} · {cost} {cash}",
		wild_speed_up = "وصلت السرعة إلى المستوى {n}!",
		wild_speed_max = "أقصى سرعة",
	},
	-- Roblox font used by all UI text (Enum.Font name, e.g. FredokaOne)
	Font = "FredokaOne",
	-- What the characters are called
	CreatureName = "حيوان",
	-- Money name on the leaderboard
	CurrencyName = "عملات",
	-- Starting cash — at least the price of the cheapest one, so a new player can buy right away
	StartingCash = 100,
	-- Sell-back ratio — selling one of yours gives this fraction of its price back
	SellRatio = 0.5,
	-- Spin / garden only: sell prices are multiplied by this (≤ 1) so spinning and selling right away never makes money
	SellScale = 1,
	-- Runway walk time (s) — how long each one takes to walk the whole runway before it leaves
	RunwaySeconds = 30,
	-- Steal hold time (s)
	StealHoldSeconds = 1.5,
	-- Walk speed while carrying — normal walk speed is 16 (carrying is never faster than walking)
	CarrySpeed = 12,
	-- Character slots per base
	SlotCount = 8,
	-- How long a base lock lasts
	LockSeconds = 60,
	-- Seconds before a base can be locked again
	LockCooldown = 120,
	-- Seconds between new characters
	SpawnSeconds = 6,
	-- Where characters start walking
	RunwayStart = Vector3.new(-98, 0.2, 0),
	-- Where characters leave the runway
	RunwayEnd = Vector3.new(98, 0.2, 0),
	-- Every character: Name, Rarity, Price, Income per second, Template (its model in ServerStorage.StealCreatures)
	Creatures = {
		{
			Name = "أرنب الغابة",
			Rarity = "common",
			Price = 50,
			Income = 1,
			Template = "1",
		},
		{
			Name = "ثعلب الصحراء",
			Rarity = "rare",
			Price = 400,
			Income = 8,
			Template = "2",
		},
		{
			Name = "ذئب الجليد",
			Rarity = "epic",
			Price = 2500,
			Income = 50,
			Template = "3",
		},
		{
			Name = "الدب القطبي",
			Rarity = "legendary",
			Price = 15000,
			Income = 88,
			Template = "4",
		},
		{
			Name = "النمر البركاني",
			Rarity = "mythic",
			Price = 100000,
			Income = 588,
			Template = "5",
		},
		{
			Name = "تنين الصهارة",
			Rarity = "mythic",
			Price = 140000,
			Income = 823,
			Template = "6",
		},
	},
	-- Color of each rarity (Weight here is a read-only copy: change the spawn weights in WeightCommon … WeightMythic)
	Rarity = {
		common = {
			Color = Color3.fromRGB(207, 214, 223),
			Weight = 55,
		},
		rare = {
			Color = Color3.fromRGB(61, 139, 255),
			Weight = 26,
		},
		epic = {
			Color = Color3.fromRGB(176, 77, 255),
			Weight = 13,
		},
		legendary = {
			Color = Color3.fromRGB(255, 200, 61),
			Weight = 5,
		},
		mythic = {
			Color = Color3.fromRGB(255, 77, 109),
			Weight = 1,
		},
	},
	-- Common spawn weight — chance = this weight ÷ the sum of the weights of the rarities this game has (shared by every common one)
	WeightCommon = 55,
	-- Rare spawn weight — chance = this weight ÷ the sum of the weights of the rarities this game has (shared by every rare one)
	WeightRare = 26,
	-- Epic spawn weight — chance = this weight ÷ the sum of the weights of the rarities this game has (shared by every epic one)
	WeightEpic = 13,
	-- Legendary spawn weight — chance = this weight ÷ the sum of the weights of the rarities this game has (shared by every legendary one)
	WeightLegendary = 5,
	-- Mythic spawn weight — chance = this weight ÷ the sum of the weights of the rarities this game has (shared by every mythic one)
	WeightMythic = 1,
	-- How many floors a base can have (1 = no upgrades)
	Levels = 3,
	-- Price to reach each floor: LevelCosts[2] for floor 2, LevelCosts[3] for floor 3 (floor 1 is free)
	LevelCosts = {
		0,
		20000,
		100000,
	},
	-- Mutation tiers rolled when one spawns (rarest first): Id, Mult (price and income multiplier), Chance (0..1), Color
	Mutations = {
		{
			Id = "rainbow",
			Mult = 5,
			Chance = 0.008,
			Color = Color3.fromRGB(255, 107, 214),
		},
		{
			Id = "diamond",
			Mult = 3,
			Chance = 0.025,
			Color = Color3.fromRGB(127, 232, 255),
		},
		{
			Id = "golden",
			Mult = 2,
			Chance = 0.06,
			Color = Color3.fromRGB(255, 207, 51),
		},
	},
	-- Mutation storm every (s) — a 60-second storm makes mutations 5× more likely; 0 = no storms
	MutationEventSeconds = 360,
	-- How long a mutation storm lasts
	MutationStormSeconds = 60,
	-- Mutation chances are multiplied by this during a storm
	MutationStormBoost = 5,
	-- Highlight color for pads, signs and UI
	AccentColor = Color3.fromRGB(255, 213, 74),
	-- Color for hazards and warnings
	DangerColor = Color3.fromRGB(217, 74, 56),
	-- "runway" = buy them walking by, "spin" = spin a wheel, "garden" = plant seeds
	Source = "wild",
	-- true = players can steal from each other
	Stealing = true,
	-- Price of one spin or seed pack
	RollCost = 0,
	-- Grow time (s) — garden only: how long a common one takes to grow; each rarer tier takes twice as long
	GrowSeconds = 15,
	-- The rarity on each slice of the wheel
