			<Item class="LocalScript" referent="RBX000000000000000000000000000013D8">
				<Properties>
					<string name="Name">StealHUD</string>
					<ProtectedString name="Source"><![CDATA[-- LevelShaper Steal (client): cash / income HUD, lock timer, toasts, and which prompts you see
-- (Steal on other bases, Sell on yours).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Text = require(ReplicatedStorage:WaitForChild("LevelShaperText"))
local remote = ReplicatedStorage:WaitForChild("StealEvent") :: RemoteEvent
local player = Players.LocalPlayer
local basesFolder = workspace:WaitForChild("Bases")

local gui = Instance.new("ScreenGui")
gui.Name = "LevelShaperSteal"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function label(pos: UDim2, size: UDim2, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.Position = pos
	l.Size = size
	l.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	l.BackgroundTransparency = 0.25
	l.TextColor3 = color
	l.TextScaled = true
	l.Font = Text.font
	l.Text = ""
	l.Parent = gui
	Instance.new("UICorner", l).CornerRadius = UDim.new(0, 10)
	return l
end

-- 左下一列：锁基地倒计时、现金、每秒收入（右上是排行榜，别叠上去）
local lockLabel = label(UDim2.new(0, 12, 1, -160), UDim2.fromOffset(230, 34), Color3.fromRGB(140, 190, 255))
-- 突变风暴横幅（顶部居中，读 workspace 的 MutationStormUntil：中途进服也看得到）
local storm = label(UDim2.new(0.5, -170, 0, 140), UDim2.fromOffset(340, 36), Color3.fromRGB(255, 120, 230))
storm.Visible = false
local cash = label(UDim2.new(0, 12, 1, -118), UDim2.fromOffset(230, 46), Color3.fromRGB(120, 255, 170))
cash.Name = "CashLabel"
local rate = label(UDim2.new(0, 12, 1, -66), UDim2.fromOffset(230, 34), Color3.new(1, 1, 1))
lockLabel.Visible = false

local function vars(extra: { [string]: any }): { [string]: any }
	extra.cash = Config.CurrencyName
	extra.creature = Config.CreatureName
	return extra
end

local function myBase(): Instance?
	local id = player:GetAttribute("StealBase")
	if type(id) ~= "number" then
		return nil
	end
	for _, m in ipairs(basesFolder:GetChildren()) do
		local v = m:FindFirstChild("BaseId")
		if v and v.Value == id then
			return m
		end
	end
	return nil
end

-- 提示：自己基地里的只显示「卖」，别人基地里的只显示「偷」（服务端照样校验）
local function fixPrompt(p: Instance)
	if not p:IsA("ProximityPrompt") then
		return
	end
	local model = p:FindFirstAncestorOfClass("Model")
	local base = model and model:GetAttribute("Base")
	if base == nil then
		return
	end
	local mine = player:GetAttribute("StealBase") == base
	if p.Name == "StealPrompt" then
		p.Enabled = not mine
	elseif p.Name == "SellPrompt" then
		p.Enabled = mine
	elseif p.Name == "UpgradePrompt" then
		-- 服务器在满级 / 没主人时把 ServerOn 设为 false；这里再把别人的藏起来
		p.Enabled = mine and p:GetAttribute("ServerOn") == true
		if not p:GetAttribute("Watched") then
			p:SetAttribute("Watched", true) -- internal
			p:GetAttributeChangedSignal("ServerOn"):Connect(function()
				fixPrompt(p)
			end)
		end
	end
end
basesFolder.DescendantAdded:Connect(function(d)
	task.defer(fixPrompt, d)
end)
local function fixAll()
	for _, d in ipairs(basesFolder:GetDescendants()) do
		fixPrompt(d)
	end
end
player:GetAttributeChangedSignal("StealBase"):Connect(fixAll)
fixAll()

local function fmtTime(s: number): string
	s = math.max(0, math.ceil(s))
	return string.format("%d:%02d", s // 60, s % 60)
end

task.spawn(function()
	while true do
		local n = player:GetAttribute("Stat_cash") or 0
		cash.Text = Config.CurrencyName .. ": " .. tostring(n)
		local b = myBase()
		local inc = b and b:GetAttribute("Income") or 0
		rate.Text = Text.t("hud_income", vars({ n = inc }))
		if b then
			local t = workspace:GetServerTimeNow()
			local lockedUntil = b:GetAttribute("LockedUntil") or 0
			local readyAt = b:GetAttribute("LockReadyAt") or 0
			lockLabel.Visible = Config.Stealing == true
			if lockedUntil > t then
				lockLabel.Text = Text.t("locked", { t = fmtTime(lockedUntil - t) })
			elseif readyAt > t then
				lockLabel.Text = Text.t("lock_ready", { t = fmtTime(readyAt - t) })
			else
				lockLabel.Text = Text.t("lock")
			end
		else
			lockLabel.Visible = false
		end
		local su = workspace:GetAttribute("MutationStormUntil") or 0
		local left = su - workspace:GetServerTimeNow()
		storm.Visible = left > 0
		if left > 0 then
			storm.Text = Text.t("storm_hud", { t = fmtTime(left) })
		end
		task.wait(0.25)
	end
end)

-- 彩虹突变：本地轮换颜色（不占服务器带宽）；每只的零件缓存一次，每秒 12 次（审查 M5：全服几十只时每帧遍历会掉帧）
local rainbowParts: { [Instance]: { BasePart } } = {}
local function partsOf(m: Instance): { BasePart }
	local list = rainbowParts[m]
	if not list then
		list = {}
		-- 蛋网格皮只转体积最大的那块（壳），花纹、底座不动
		local shell: BasePart? = nil
		local shellVol = 0
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Name == "EggSkin" then
				local vol = d.Size.X * d.Size.Y * d.Size.Z
				if vol > shellVol then
					shell, shellVol = d, vol
				end
			end
		end
		for _, d in ipairs(m:GetDescendants()) do
			-- 3D 外观下方块零件是隐身的，不用转
			if d:IsA("BasePart") and ((d.Name == "CreaturePart" and d.Material == Enum.Material.Neon and d.Transparency < 1) or d == shell) then
				table.insert(list, d)
			end
		end
		rainbowParts[m] = list
	end
	return list
end
CollectionService:GetInstanceRemovedSignal("StealRainbow"):Connect(function(m)
	rainbowParts[m] = nil
end)
task.spawn(function()
	while true do
		local hue = (os.clock() * 0.25) % 1
		for _, m in ipairs(CollectionService:GetTagged("StealRainbow")) do
			if m.Parent then
				for _, d in ipairs(partsOf(m)) do
					d.Color = Color3.fromHSV((hue + (d.Position.Y * 0.05)) % 1, 0.75, 1)
				end
			else
				rainbowParts[m] = nil
			end
		end
		task.wait(1 / 12)
	end
end)

-- ---------- 图鉴：每一只（见过的才显示名字）、稀有度色、每秒收入、出现概率、见过的突变 ----------
local seenSet: { [string]: boolean } = {}
local totalWeight = 0
local rarityCount = {}
for _, c in ipairs(Config.Creatures) do
	rarityCount[c.Rarity] = (rarityCount[c.Rarity] or 0) + 1
end
local WEIGHT_KEY = { common = "WeightCommon", rare = "WeightRare", epic = "WeightEpic", legendary = "WeightLegendary", mythic = "WeightMythic" }
local function weightOf(rarity: string): number
	local k = WEIGHT_KEY[rarity]
	return (k and Config[k]) or (Config.Rarity[rarity] and Config.Rarity[rarity].Weight) or 1
end
for r in pairs(rarityCount) do
	totalWeight += weightOf(r)
end
local function chanceOf(c): number
	if totalWeight <= 0 then
		return 0
	end
	return weightOf(c.Rarity) / totalWeight / rarityCount[c.Rarity] * 100
end

local indexButton = Instance.new("TextButton")
indexButton.Name = "IndexButton"
indexButton.AnchorPoint = Vector2.new(1, 0.5)
indexButton.Position = UDim2.new(1, -12, 0.5, 0)
indexButton.Size = UDim2.fromOffset(110, 40)
indexButton.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
indexButton.BackgroundTransparency = 0.2
indexButton.TextColor3 = Color3.fromRGB(255, 214, 90)
indexButton.TextScaled = true
indexButton.Font = Text.font
indexButton.Text = Text.t("index")
indexButton.Parent = gui
Instance.new("UICorner", indexButton).CornerRadius = UDim.new(0, 10)

local panel = Instance.new("Frame")
panel.Name = "IndexPanel"
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Position = UDim2.new(1, -130, 0.5, 0)
panel.Size = UDim2.fromOffset(330, 380)
panel.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
panel.BackgroundTransparency = 0.1
panel.Visible = false
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 34)
title.Position = UDim2.fromOffset(10, 6)
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1, 1, 1)
title.TextScaled = true
title.Font = Text.font
title.Parent = panel
local list = Instance.new("ScrollingFrame")
list.Position = UDim2.fromOffset(10, 46)
list.Size = UDim2.new(1, -20, 1, -56)
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.ScrollBarThickness = 6
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.Parent = panel
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 4)
layout.Parent = list

local function rebuildIndex()
	for _, ch in ipairs(list:GetChildren()) do
		if ch:IsA("Frame") then
			ch:Destroy()
		end
	end
	local found = 0
	for i, c in ipairs(Config.Creatures) do
		local known = seenSet[c.Name] == true
		if known then
			found += 1
		end
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 34)
		row.BackgroundColor3 = Color3.fromRGB(34, 37, 50)
		row.LayoutOrder = i
		row.Parent = list
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
		local info = Config.Rarity[c.Rarity]
		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(0, 6, 1, 0)
		bar.BackgroundColor3 = if info then info.Color else Color3.new(1, 1, 1)
		bar.BorderSizePixel = 0
		bar.Parent = row
		local name = Instance.new("TextLabel")
		name.Position = UDim2.fromOffset(12, 0)
		name.Size = UDim2.new(0.55, -12, 1, 0)
		name.BackgroundTransparency = 1
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextScaled = true
		name.Font = Text.font
		name.TextColor3 = if known then Color3.new(1, 1, 1) else Color3.fromRGB(130, 134, 150)
		name.Text = if known then c.Name else Text.t("unknown")
		name.Parent = row
		local sub = name:Clone()
		sub.Position = UDim2.new(0.55, 0, 0, 0)
		sub.Size = UDim2.new(0.45, -6, 1, 0)
		sub.TextXAlignment = Enum.TextXAlignment.Right
		sub.TextColor3 = if info then info.Color else Color3.new(1, 1, 1)
		sub.Text = Text.t("income", vars({ n = c.Income })) .. "  " .. Text.t("chance", { p = string.format("%.1f", chanceOf(c)) })
		sub.Parent = row
		-- 见过的突变：名字后面的小色点
		local dx = 0
		for _, m in ipairs(Config.Mutations or {}) do
			if seenSet[c.Name .. "|" .. m.Id] then
				local dot = Instance.new("Frame")
				dot.Size = UDim2.fromOffset(8, 8)
				dot.Position = UDim2.new(0.55, -16 - dx, 0.5, -4)
				dot.BackgroundColor3 = m.Color
				dot.Parent = row
				Instance.new("UICorner", dot).CornerRadius = UDim.new(0.5, 0)
				dx += 10
			end
		end
	end
	title.Text = Text.t("index_title", { n = found, total = #Config.Creatures })
end
indexButton.Activated:Connect(function()
	panel.Visible = not panel.Visible
end)
panel:GetPropertyChangedSignal("Visible"):Connect(function()
	if panel.Visible then
		rebuildIndex()
	end
end)

local toast = Instance.new("TextLabel")
toast.Name = "Toast"
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.Position = UDim2.new(0.5, 0, 0, 90)
toast.Size = UDim2.fromOffset(460, 40)
toast.BackgroundTransparency = 1
toast.TextScaled = true
toast.Font = Text.font
toast.TextStrokeTransparency = 0.4
toast.Visible = false
toast.Parent = gui
local toastId = 0
local function showToast(text: string, color: Color3, seconds: number)
	toastId += 1
	local mine = toastId
	toast.Text = text
	toast.TextColor3 = color
	toast.Visible = true
	task.delay(seconds, function()
		if toastId == mine then
			toast.Visible = false
		end
	end)
end

-- ---------- 我的基地：牌子高亮 + 指向它的光束 / 距离箭头 ----------
-- 基地编号来自三处，谁先到用谁：服务端的 "base" 事件、ready 握手后的补发、玩家属性 StealBase（属性是状态，不会丢）
local GOLD = Color3.fromRGB(255, 214, 90)
local myBase: number? = nil
local arrived = false
local markGui: BillboardGui? = nil
local arrowGui: BillboardGui? = nil
local beam: Beam? = nil
local beamTarget: Attachment? = nil
local beamSource: Attachment? = nil
local introDoneAt = os.clock() + 2 + 5
local function setupBase(n: number)
	if myBase == n then
		return
	end
	myBase = n
	arrived = false
	-- QA 与排查用：本地属性（客户端设的不会同步到服务端）
	player:SetAttribute("StealBaseSeen", n)
	-- 进服提示读完之后再说「你的基地是 N 号」
	task.delay(math.max(0, introDoneAt - os.clock()), function()
		if myBase == n then
			showToast(Text.t("intro_base", { n = n }), GOLD, 7)
		end
	end)
	task.spawn(function()
		local model = basesFolder:WaitForChild("Base" .. tostring(n), 15)
		local floor = model and model:WaitForChild("BaseFloor", 15) :: BasePart?
		local sign = model and model:WaitForChild("BaseSign", 15) :: BasePart?
		if myBase ~= n or not floor then
			return
		end
		for _, g in ipairs({ markGui, arrowGui, beamTarget }) do
			if g then
				g:Destroy()
			end
		end
		if beam then
			beam:Destroy()
			beam = nil
		end
		-- 牌子上方一块大金牌：远处也看得见（AlwaysOnTop、不限距离）
		if sign then
			local mark = Instance.new("BillboardGui")
			mark.Name = "YourBaseMark"
			mark.Size = UDim2.fromOffset(340, 64)
			mark.StudsOffset = Vector3.new(0, 7, 0)
			mark.AlwaysOnTop = true
			mark.MaxDistance = math.huge
			local frame = Instance.new("Frame")
			frame.Size = UDim2.fromScale(1, 1)
			frame.BackgroundColor3 = GOLD
			frame.Parent = mark
			Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.new(1, -16, 1, -8)
			t.Position = UDim2.fromOffset(8, 4)
			t.BackgroundTransparency = 1
			t.TextScaled = true
			t.Font = Text.font
			t.TextColor3 = Color3.fromRGB(40, 30, 10)
			t.Text = Text.t("base_mark", { n = n })
			t.Parent = frame
			mark.Parent = sign
			markGui = mark
		end
		-- 基地中央上空的距离箭头 + 一条从自己身上拉过去的光束（走进基地后消失）
		local target = Instance.new("Attachment")
		target.Name = "YourBaseTarget"
		target.Position = Vector3.new(0, 6, 0)
		target.Parent = floor
		beamTarget = target
		local arrow = Instance.new("BillboardGui")
		arrow.Name = "YourBaseArrow"
		arrow.Size = UDim2.fromOffset(260, 56)
		arrow.AlwaysOnTop = true
		arrow.MaxDistance = math.huge
		arrow.Adornee = target
		local at = Instance.new("TextLabel")
		at.Size = UDim2.fromScale(1, 1)
		at.BackgroundTransparency = 1
		at.TextScaled = true
		at.Font = Text.font
		at.TextColor3 = GOLD
		at.TextStrokeTransparency = 0.2
		at.Parent = arrow
		arrow.Parent = floor
		arrowGui = arrow
		local b = Instance.new("Beam")
		b.Name = "YourBaseBeam"
		b.Color = ColorSequence.new(GOLD)
		b.LightEmission = 1
		b.Transparency = NumberSequence.new(0.35)
		b.Width0 = 1.2
		b.Width1 = 1.2
		b.FaceCamera = true
		b.Segments = 1
		b.Attachment1 = target
		b.Parent = floor
		beam = b
		-- 每 0.25 秒：跟着角色重挂光束起点、更新距离；第一次走进基地范围就收起
		while myBase == n and not arrived do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				if not beamSource or beamSource.Parent ~= hrp then
					if beamSource then
						beamSource:Destroy()
					end
					beamSource = Instance.new("Attachment")
					beamSource.Name = "YourBaseSource"
					beamSource.Parent = hrp
					b.Attachment0 = beamSource
				end
				local d = hrp.Position - floor.Position
				at.Text = Text.t("base_arrow", { n = n, m = math.floor(Vector3.new(d.X, 0, d.Z).Magnitude / 5 + 0.5) * 5 })
				local half = floor.Size.X / 2
				if math.abs(d.X) < half and math.abs(d.Z) < floor.Size.Z / 2 and math.abs(d.Y) < 12 then
					arrived = true
				end
			end
			task.wait(0.25)
		end
		if myBase == n then
			arrow:Destroy()
			b:Destroy()
			if beamSource then
				beamSource:Destroy()
				beamSource = nil
			end
		end
	end)
end
player:GetAttributeChangedSignal("StealBase"):Connect(function()
	local n = player:GetAttribute("StealBase")
	if type(n) == "number" then
		setupBase(n)
	end
end)
do
	local n = player:GetAttribute("StealBase")
	if type(n) == "number" then
		setupBase(n)
	end
end

remote.OnClientEvent:Connect(function(kind: string, text: any, color: string?)
	if kind == "seen" then
		seenSet = {}
		for _, k in ipairs(text) do
			seenSet[k] = true
		end
		if panel.Visible then
			rebuildIndex()
		end
		return
	end
	if kind == "base" then
		if type(text) == "number" then
			setupBase(text)
		end
		return
	end
	if kind ~= "toast" then
		return
	end
	showToast(text, if color == "danger" then Color3.fromRGB(255, 110, 110) else GOLD, 3)
end)
-- 握手：事件连好了，让服务端把基地编号（和之前可能错过的提示）再发一遍
remote:FireServer("ready")

-- 进服提示一次
task.delay(2, function()
	showToast(Text.t("intro", { creature = Config.CreatureName }), GOLD, 5)
end)
