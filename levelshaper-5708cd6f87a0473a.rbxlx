		<Item class="ModuleScript" referent="RBX0000000000000000000000000000133F">
			<Properties>
				<string name="Name">LevelShaperText</string>
				<ProtectedString name="Source"><![CDATA[-- LevelShaper text: every player-facing string comes from GameConfig.Strings.
-- Edit the text in GameConfig; {name} placeholders are filled in by Text.t(key, vars).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))

local Text = {}

-- Enum.Font[name] errors on unknown names, so fall back to FredokaOne
local ok, font = pcall(function()
	return (Enum.Font :: any)[Config.Font]
end)
Text.font = if ok and font then font else Enum.Font.FredokaOne

function Text.t(key: string, vars: { [string]: any }?): string
	local s = (Config.Strings and Config.Strings[key]) or key
	return (string.gsub(s, "{(%w+)}", function(k)
		local v = vars and vars[k]
		if v == nil then
			return "{" .. k .. "}"
		end
		return tostring(v)
	end))
end

-- 立牌正反两面贴字（深色牌面、白字）
function Text.surface(part: BasePart, text: string)
	-- 文件里已经写好的牌面（LabelGui，见 sign-text.ts）：只改字，不再叠一层
	local baked = false
	for _, sg in ipairs(part:GetChildren()) do
		if sg:IsA("SurfaceGui") and sg.Name == "LabelGui" then
			local label = sg:FindFirstChildWhichIsA("TextLabel")
			if label then
				label.Text = text
				label.Font = Text.font
				baked = true
			end
		end
	end
	if baked then
		return
	end
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextScaled = true
		label.Font = Text.font
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.6
		label.Parent = sg
		sg.Parent = part
	end
end

-- 头顶浮字（展示台上的武器名等）
function Text.billboard(part: BasePart, text: string, color: Color3): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 36)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 80
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Text.font
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Parent = bb
	bb.Parent = part
	return bb
end

return Text
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX00000000000000000000000000001340">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX00000000000000000000000000001341">
			<Properties>
				<string name="Name">StealServer</string>
				<ProtectedString name="Source"><![CDATA[-- LevelShaper Blocks boot: starts the blocks of this game's recipe in dependency order.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Modules = ServerScriptService:WaitForChild("LevelShaperModules")
local Bus = require(Modules:WaitForChild("LevelShaperBlocks"))
local Config = require(ReplicatedStorage:WaitForChild("BlocksConfig"))

local ORDER = { "currency", "plot", "steal" }
local StateModule = Modules:FindFirstChild("State")
require(Modules:WaitForChild("LevelShaperBlocksV2")).install(Bus, Config.Events, if StateModule then require(StateModule) else nil)

-- 按名字回落时的范围：零件自己或祖先带 Block = 积木 id，或祖先文件夹就叫积木 id
local function inScope(inst: Instance, block: string): boolean
	local a: Instance? = inst
	while a and a ~= workspace do
		if a:GetAttribute("Block") == block or (a ~= inst and a.Name == block) then
			return true
		end
		a = a.Parent
	end
	return false
end

-- 按属性找零件：Block = 积木 id（可省），BlockRole = 角色
local function find(block: string?, role: string): { Instance }
	local out = {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:GetAttribute("BlockRole") == role and (block == nil or inst:GetAttribute("Block") == block) then
			table.insert(out, inst)
		end
	end
	if #out == 0 and block ~= nil then
		for _, inst in ipairs(workspace:GetDescendants()) do
			if inst.Name == role and inScope(inst, block) then
				table.insert(out, inst)
			end
		end
	end
	return out
end

-- 声明的操作挂成 BindableFunction（ReplicatedStorage.LevelShaperOps/<成员名>），旧玩法脚本与 AI 机制可调用
local ops = Instance.new("Folder")
ops.Name = "LevelShaperOps"
ops.Parent = ReplicatedStorage
local function expose(member: string, fn)
	local b = Instance.new("BindableFunction")
	b.Name = member
	b.OnInvoke = fn
	b.Parent = ops
end

local list = {}
local Stats = require(Modules:WaitForChild("Stats"))
for _, id in ipairs(ORDER) do
	local ok, mod = pcall(require, Modules:WaitForChild("Blocks"):WaitForChild(id))
	if ok and type(mod) == "table" and type(mod.start) == "function" then
		table.insert(list, { id = id, module = mod })
	else
		warn("[blocks] " .. id .. " failed to load: " .. tostring(mod))
		-- 少了一块积木，它的存档字段就没人写：这次开服不存档，免得盖掉老进度
		Stats.freeze("block " .. id .. " failed to load")
	end
end

Bus.run(list, {
	Config = Config,
	Stats = Stats,
	Save = require(Modules:WaitForChild("Save")),
	Text = ReplicatedStorage:FindFirstChild("LevelShaperText") and require(ReplicatedStorage.LevelShaperText) or nil,
	GameConfig = ReplicatedStorage:FindFirstChild("GameConfig") and require(ReplicatedStorage.GameConfig) or nil,
	find = find,
	log = warn,
	expose = expose,
})
]]></ProtectedString>
				<bool name="Disabled">false</bool>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX00000000000000000000000000001342">
			<Properties>
				<string name="Name">LevelShaperModules</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000001343">
				<Properties>
					<string name="Name">Save</string>
					<ProtectedString name="Source"><![CDATA[-- LevelShaper Save: DataStore wrapper. Writes back only after a successful read,
-- so a failed load never overwrites an old save with defaults.
local DataStoreService = game:GetService("DataStoreService")

local Save = {}
Save.__index = Save

function Save.new(storeName: string)
	local self = setmetatable({ store = nil, loaded = {} }, Save)
	pcall(function()
		self.store = DataStoreService:GetDataStore(storeName)
	end)
	return self
end

-- 返回存档表（新玩家为空表）；读档失败返回 nil，且之后不会写回
function Save:load(player: Player): { [string]: any }?
	if not self.store then
		return nil
	end
	local ok, data = pcall(function()
		return self.store:GetAsync("p_" .. player.UserId)
	end)
	if not ok then
		return nil
	end
	self.loaded[player] = true
	return if type(data) == "table" then data else {}
end

-- 返回是否真的写进去了（没读成档、没有 DataStore、写失败都是 false）
function Save:save(player: Player, data: { [string]: any }): boolean
	if not self.store or not self.loaded[player] then
		return false
	end
	return (pcall(function()
		self.store:SetAsync("p_" .. player.UserId, data)
	end))
end

function Save:forget(player: Player)
	self.loaded[player] = nil
end

return Save
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000001344">
				<Properties>
					<string name="Name">Stats</string>
					<ProtectedString name="Source"><![CDATA[-- LevelShaper Stats: leaderstats with display names from GameConfig.Strings.
-- Read and write values by key (Stats.get(player, "wins")), never by the display name.
local Players = game:GetService("Players")

local Stats = {}
local defs = {}
local values: { [Player]: { [string]: IntValue } } = {}
local save = nil
local ready: { [Player]: boolean } = {}
-- 存档真的读成了（读档失败时照样 ready，但这次进服的进度不会存）；Studio 本地文件本来就不存档，算读成
local loadedOk: { [Player]: boolean } = {}
-- hooks.load(player, data)：读档之后调（恢复统计值之外的存档字段、按存档做初始化）
-- hooks.dump(player) -> table：存档时合并进去的额外字段
local hooks = nil
-- 读档时的原始存档：存档时以它为底，dump 没给出的字段保留原值（积木没启动成时不把老进度写没，M3a 审查 I1）
local raw: { [Player]: { [string]: any } } = {}
-- 冻结后不再写存档（启动器发现有积木没加载 / 启动成时调；同改造前「脚本坏了就不存」）
local frozen = false

local function added(player: Player)
	if values[player] then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	-- hidden = true：存档、有属性，但不上排行榜（如 RPG 的累计经验）
	local hidden = Instance.new("Folder")
	hidden.Name = "LevelShaperStats"
	local mine = {}
	for i, d in ipairs(defs) do
		local v = Instance.new("IntValue")
		v.Name = d.label
		v.Value = d.default or 0
		-- 玩家列表按 IsPrimary 那一列排序、放在最前（否则列的先后看复制顺序）
		if i == 1 then
			local primary = Instance.new("BoolValue")
			primary.Name = "IsPrimary"
			primary.Value = true
			primary.Parent = v
		end
		v.Parent = if d.hidden then hidden else folder
		mine[d.key] = v
		-- 建好就写属性（HUD 读档期间也显示默认值）；直接改 .Value 的旧代码也同步过去
		player:SetAttribute("Stat_" .. d.key, v.Value) -- internal
		v.Changed:Connect(function(n)
			player:SetAttribute("Stat_" .. d.key, n) -- internal
		end)
	end
	values[player] = mine
	folder.Parent = player
	hidden.Parent = player
	local data = nil
	if save then
		data = save:load(player)
		-- 读档途中玩家已离开：不留任何引用
		if values[player] ~= mine then
			save:forget(player)
			return
		end
		if data then
			-- 只覆盖存档里真有的字段：新玩家读档那一瞬间攒下的进度不被清零
			for _, d in ipairs(defs) do
				if d.saved and data[d.key] ~= nil then
					mine[d.key].Value = tonumber(data[d.key]) or (d.default or 0)
				end
			end
		end
	end
	raw[player] = if type(data) == "table" then data else nil
	if hooks and hooks.load then
		hooks.load(player, data or {})
	end
	loadedOk[player] = not save or data ~= nil or game:GetService("RunService"):IsStudio()
	ready[player] = true
end

-- 读档（与 hooks.load）完成后为 true；在此之前发的奖励会被读档覆盖（如开发者商品回执应返回 NotProcessedYet）
function Stats.ready(player: Player): boolean
	return ready[player] == true
end

-- 存档读成了（这次进服的进度会存下来）：用统计值换东西（背包卖钱）之前要看这个，否则换来的钱存不下
function Stats.loaded(player: Player): boolean
	return loadedOk[player] == true
end

function Stats.flush(player: Player)
	local mine = values[player]
	if not save or not mine or frozen then
		return
	end
	local data = table.clone(raw[player] or {})
	for _, d in ipairs(defs) do
		if d.saved then
			data[d.key] = mine[d.key].Value
		end
	end
	if hooks and hooks.dump then
		for k, v in pairs(hooks.dump(player) or {}) do
			data[k] = v
		end
	end
	save:save(player, data)
end

-- defs: { { key = "wins", label = "Wins", saved = true, default = 0, hidden = false }, ... }（第一项是排行榜排序依据）
-- 存档字段名 = key：旧玩法迁过来时沿用原字段名，老玩家的存档照常读得到
function Stats.setup(list, saveObj, h)
	defs = list
	save = saveObj
	hooks = h
	Players.PlayerAdded:Connect(added)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(added, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		ready[p] = nil
		loadedOk[p] = nil
		Stats.flush(p)
		values[p] = nil
		raw[p] = nil
		if save then
			save:forget(p)
		end
	end)
	-- 关服时并行存档（逐个 SetAsync 人多时会顶到 30 秒关服上限）
	game:BindToClose(function()
		local left = 0
		for _, p in ipairs(Players:GetPlayers()) do
			left += 1
			task.spawn(function()
				Stats.flush(p)
				left -= 1
			end)
		end
		local t0 = os.clock()
		while left > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in ipairs(Players:GetPlayers()) do
				Stats.flush(p)
			end
		end
	end)
end

-- 不再写存档（这次开服期间）：有积木没加载 / 启动成时由启动器调，免得缺了字段的存档盖掉老进度
function Stats.freeze(reason: string?)
	if not frozen then
		frozen = true
		warn("[Stats] saving disabled for this server: " .. tostring(reason)) -- internal
	end
end

-- 取统计值对象（旧玩法按 .Value 读写的代码直接用）；玩家还没建好时返回 nil
function Stats.value(player: Player, key: string): IntValue?
	return values[player] and values[player][key]
end

function Stats.get(player: Player, key: string): number
	local v = values[player] and values[player][key]
	return if v then v.Value else 0
end

function Stats.set(player: Player, key: string, n: number)
	local v = values[player] and values[player][key]
	if v then
		v.Value = n
		player:SetAttribute("Stat_" .. key, n) -- internal
	end
end

function Stats.add(player: Player, key: string, n: number)
	Stats.set(player, key, Stats.get(player, key) + n)
end

function Stats.resetAll(key: string)
	for p in pairs(values) do
		Stats.set(p, key, 0)
	end
end

return Stats
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000001345">
				<Properties>
					<string name="Name">State</string>
					<ProtectedString name="Source"><![CDATA[-- LevelShaper State: shared key-value state with subscriptions (server authoritative).
-- Values are mirrored to attributes of ReplicatedStorage.LevelShaperState so client HUDs can read and listen:
--   local s = ReplicatedStorage:WaitForChild("LevelShaperState"); s:GetAttribute("round_phase"); s:GetAttributeChangedSignal("round_phase")
-- Key rule: a letter first, then letters, digits and "." only ("round.timeLeft"); a "." becomes "_" in the attribute name.
-- "_" is not allowed in keys, so two different keys can never map to the same attribute name. Tables are server-only (not mirrored).
-- Subscribers run in their own thread (task.spawn): a handler that yields (task.wait, DataStore, ...) never blocks the writer
-- or the other subscribers; errors are caught and logged.
local State = {}

local function attrName(key: string): string
	return (string.gsub(key, "%.", "_"))
end

-- 一份独立的状态表；root 是同步目标（有 SetAttribute 的东西，Roblox 里是 Folder；测试可传假的 / nil）
function State.new(root: any?, log: ((string) -> ())?)
	local report = log or function(_m) end
	local values: { [string]: any } = {}
	local subs: { [string]: { (any, any, string) -> () } } = {}
	local self = {}

	local function check(key: any)
		if type(key) ~= "string" or not string.match(key, "^%a[%w%.]*$") or #key > 80 then
			error("bad state key: " .. tostring(key), 3)
		end
	end

	function self.get(key: string, default: any?): any
		check(key)
		local v = values[key]
		if v == nil then
			return default
		end
		return v
	end

	-- 写入；值没变返回 false（不通知），变了同步属性、通知订阅者（出错只记日志）并返回 true
	function self.set(key: string, value: any): boolean
		check(key)
		local old = values[key]
		if old == value then
			return false
		end
		values[key] = value
		if root then
			local ok = pcall(root.SetAttribute, root, attrName(key), value)
			if not ok and type(value) ~= "table" then
				report("[state] cannot mirror " .. key .. " (" .. typeof(value) .. ")")
			end
		end
		for _, list in ipairs({ subs[key] or {}, subs["*"] or {} }) do
			for _, fn in ipairs(table.clone(list)) do
				-- 各订阅者在自己的线程里跑：处理函数 yield 不会卡住写入方，出错只记日志
				task.spawn(function()
					local ok, err = pcall(fn, value, old, key)
					if not ok then
						report("[state] subscriber for '" .. key .. "' failed: " .. tostring(err))
					end
				end)
			end
		end
		return true
	end

	-- 订阅某个键（"*" = 所有键）：fn(新值, 旧值, 键)；返回取消订阅的函数
	function self.on(key: string, fn: (any, any, string) -> ())
		if key ~= "*" then
			check(key)
		end
		subs[key] = subs[key] or {}
		table.insert(subs[key], fn)
		return function()
			local list = subs[key]
			for i, f in ipairs(list or {}) do
				if f == fn then
					table.remove(list, i)
					break
				end
			end
		end
	end

	function self.snapshot(): { [string]: any }
		return table.clone(values)
	end

	return self
end

-- 全局共享的那一份（第一次用时在 ReplicatedStorage 下建 LevelShaperState 文件夹）
local shared
function State.shared()
	if not shared then
		local rs = game:GetService("ReplicatedStorage")
		local folder = rs:FindFirstChild("LevelShaperState")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "LevelShaperState"
			folder.Parent = rs
		end
		shared = State.new(folder, warn)
	end
	return shared
end

function State.get(key: string, default: any?): any
	return State.shared().get(key, default)
end
function State.set(key: string, value: any): boolean
	return State.shared().set(key, value)
end
function State.on(key: string, fn: (any, any, string) -> ())
	return State.shared().on(key, fn)
end
function State.snapshot(): { [string]: any }
	return State.shared().snapshot()
end

return State
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000001346">
				<Properties>
					<string name="Name">LevelShaperBlocks</string>
					<ProtectedString name="Source"><![CDATA[-- LevelShaper Blocks bus: events and declared operations between blocks.
-- Pure Luau (no services) so it can be tested outside Roblox. A failing handler never breaks the others.
local Bus = {}

function Bus.new(log: ((string) -> ())?)
	local handlers: { [string]: { (...any) -> () } } = {}
	local ops: { [string]: { block: string, fn: (...any) -> ...any } } = {}
	local report = log or function(_m) end
	local self = {}

	-- 订阅事件；返回取消订阅的函数
	function self.on(event: string, fn: (...any) -> ())
		handlers[event] = handlers[event] or {}
		table.insert(handlers[event], fn)
		return function()
			local list = handlers[event]
			for i, f in ipairs(list or {}) do
				if f == fn then
					table.remove(list, i)
					break
				end
			end
		end
	end

	-- 发事件：按订阅顺序调用；某个处理函数出错只记日志，不影响其余
	function self.emit(event: string, ...)
		local list = handlers[event]
		if not list then
			return
		end
		for _, fn in ipairs(table.clone(list)) do
			local ok, err = pcall(fn, ...)
			if not ok then
				report("[blocks] handler for '" .. event .. "' failed: " .. tostring(err))
			end
		end
	end

	-- 声明一个操作（同名只能有一个提供者）
	function self.provide(block: string, op: string, fn: (...any) -> ...any)
		if ops[op] then
			error("operation '" .. op .. "' is already provided by " .. ops[op].block, 2)
		end
		ops[op] = { block = block, fn = fn }
	end

	function self.has(op: string): boolean
		return ops[op] ~= nil
	end

	-- 调用别的积木声明的操作；没人提供就报错（配方检查应已挡住）
	function self.call(op: string, ...)
		local o = ops[op]
		if not o then
			error("no block provides operation '" .. op .. "'", 2)
		end
		return o.fn(...)
	end

	return self
end

-- 生命周期：require 好的积木按顺序 declare（登记统计 / 存档字段）→ 统一 Stats.setup → start。
-- list = { { id, module } }；env = { Config, Stats, Save, Text?, GameConfig?, find, log, expose }（Roblox 里由启动器传入，Lune 测试传假的）
function Bus.run(list, env)
	local log = env.log or function(_m) end
	local bus = Bus.new(log)
	local defs, persist, onLoaded = {}, {}, {}
	local function ctxFor(id: string)
		return {
			id = id,
			params = (env.Config.Blocks and env.Config.Blocks[id]) or {},
			on = bus.on,
			emit = bus.emit,
			call = bus.call,
			has = bus.has,
			provide = function(op, fn)
				bus.provide(id, op, fn)
			end,
			-- declare 阶段用：{ key, label, saved, default, hidden, order? }；排在最前的是排行榜排序列。
			-- 默认按登记顺序（依赖在前）；order 小的排前（默认 0），玩法要保持改造前的列顺序时用
			stat = function(def)
				table.insert(defs, def)
			end,
			-- declare 阶段用：存档里的额外字段（load(player, value) / dump(player) -> value）
			persist = function(field: string, hooks)
				table.insert(persist, { field = field, load = hooks.load, dump = hooks.dump })
			end,
			-- declare 阶段用：存档读完（所有 persist 字段都 load 过）后回调 fn(player)；新玩家没有存档也会调
			loaded = function(fn)
				table.insert(onLoaded, { id = id, fn = fn })
			end,
			find = function(role, block)
				return env.find(block or id, role)
			end,
			Stats = env.Stats,
			-- 玩家可见文字（LevelShaperText：按游戏语言）；没有时为 nil
			text = env.Text,
			-- 玩法的 GameConfig（创作者在 Studio 里改的数值）；没有时为 nil
			gameConfig = env.GameConfig,
		}
	end
	local live = {}
	-- 有积木 declare / start 失败：冻结存档（它的字段 dump 不出来，整份写会抹掉老进度）
	local broken = {}
	for _, b in ipairs(list) do
		local ctx = ctxFor(b.id)
		local ok, err = true, nil
		if type(b.module.declare) == "function" then
			ok, err = pcall(b.module.declare, ctx)
		end
		if ok then
			table.insert(live, { id = b.id, module = b.module, ctx = ctx })
		else
			log("[blocks] " .. b.id .. " failed to declare: " .. tostring(err))
			table.insert(broken, b.id)
		end
	end
	if #defs > 0 then
		local rank = {}
		for i, d in ipairs(defs) do
			rank[d] = i
		end
		table.sort(defs, function(a, b)
			local oa, ob = tonumber(a.order) or 0, tonumber(b.order) or 0
			if oa ~= ob then
				return oa < ob
			end
			return rank[a] < rank[b]
		end)
		-- 几块积木登记了同名的列（wins 这类共享的计数：回合循环 / 赛道 / 胜负条件各登记一份）并成一列：
		-- 排在最前的那份为准，saved 取「或」；Stats.setup 原样收到会出两行同名的排行榜列，其中一行永远是 0。
		-- 老玩法的几块积木不登记同名列，这一步对它们不起作用
		do
			local merged, byKey = {}, {}
			for _, d in ipairs(defs) do
				local first = byKey[d.key]
				if first then
					first.saved = first.saved or d.saved
				else
					byKey[d.key] = d
					table.insert(merged, d)
				end
			end
			defs = merged
		end
		local store = env.Config.SaveStore
		env.Stats.setup(defs, if store and env.Save then env.Save.new(store) else nil, {
			load = function(player, data)
				for _, p in ipairs(persist) do
					if p.load then
						local ok, err = pcall(p.load, player, data[p.field])
						if not ok then
							log("[blocks] load " .. p.field .. ": " .. tostring(err))
						end
					end
				end
				for _, h in ipairs(onLoaded) do
					local ok, err = pcall(h.fn, player)
					if not ok then
						log("[blocks] " .. h.id .. " loaded: " .. tostring(err))
					end
				end
			end,
			dump = function(player)
				local out = {}
				for _, p in ipairs(persist) do
					if p.dump then
						local ok, v = pcall(p.dump, player)
						if ok then
							out[p.field] = v
						end
					end
				end
				return out
			end,
		})
	end
	for _, b in ipairs(live) do
		local ok, err = pcall(b.module.start, b.ctx)
		if not ok then
			log("[blocks] " .. b.id .. " failed to start: " .. tostring(err))
			table.insert(broken, b.id)
		end
	end
	if #broken > 0 and env.Stats.freeze then
		env.Stats.freeze("blocks failed: " .. table.concat(broken, ", "))
	end
	-- 声明的操作给别的脚本用（旧玩法脚本、AI 机制）：Config.Expose = { [op] = 成员名 }
	if env.expose then
		for op, member in pairs(env.Config.Expose or {}) do
			if bus.has(op) then
				env.expose(member, function(...)
					return bus.call(op, ...)
				end)
			end
		end
	end
	bus.emit("blocks:ready")
	return bus
end

return Bus
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000001347">
				<Properties>
					<string name="Name">LevelShaperBlocksV2</string>
					<ProtectedString name="Source"><![CDATA[-- LevelShaper Blocks v2: undeclared-event warnings and shared-state operations on top of the bus.
-- Installed by the boot script before Bus.run. It wraps Bus.new, so the Bus module itself is unchanged.
-- Config.Events lists the event names this game's blocks declared (plus the standard events).
-- Dispatch rule (spec v2): every event handler runs in its own thread (task.spawn), so a handler that yields never
-- blocks the block that emitted the event; handlers still start in subscription order and run until their first yield
-- before emit returns. A handler error is caught and logged. State subscribers follow the same rule (State module).
-- Installing twice on the same Bus is a no-op.
local V2 = {}
local installed: { [any]: any } = setmetatable({}, { __mode = "k" })

-- events：这一局声明过的事件名（Config.Events）；State：共享状态模块（这一局没带就没有 state.* 操作）
function V2.install(Bus, events: { string }?, State: any?)
	if installed[Bus] ~= nil and installed[Bus] == Bus.new then
		return
	end
	local declared: { [string]: boolean }? = nil
	if events then
		declared = {}
		for _, e in ipairs(events) do
			declared[e] = true
		end
	end
	local origNew = Bus.new

	Bus.new = function(log)
		local self = origNew(log)
		local report = log or function(_m) end
		local warned: { [string]: boolean } = {}
		local function check(kind: string, event: string)
			if declared and not declared[event] and not warned[event] then
				warned[event] = true
				report("[blocks] undeclared event '" .. event .. "' (" .. kind .. "): declare it in the block's provides.events or use a standard event")
			end
		end
		local on, emit = self.on, self.emit
		self.on = function(event: string, fn)
			check("on", event)
			-- 每个处理函数在自己的线程里跑（task.spawn）；取消订阅仍按包装后的函数登记，on 返回的取消函数照常有效
			return on(event, function(...)
				local args = table.pack(...)
				task.spawn(function()
					local ok, err = pcall(fn, table.unpack(args, 1, args.n))
					if not ok then
						report("[blocks] handler for '" .. event .. "' failed: " .. tostring(err))
					end
				end)
			end)
		end
		self.emit = function(event: string, ...)
			check("emit", event)
			return emit(event, ...)
		end
		-- 共享状态（server 权威）：ctx.call("state.set", key, value) / ("state.get", key, default) / ("state.on", key, fn) -> 取消订阅
		if State then
			self.provide("state", "state.get", State.get)
			self.provide("state", "state.set", State.set)
			self.provide("state", "state.on", State.on)
		end
		return self
	end
	installed[Bus] = Bus.new
end

return V2
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000000000000000000000000001348">
				<Properties>
					<string name="Name">Blocks</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001349">
					<Properties>
						<string name="Name">currency</string>
						<ProtectedString name="Source"><![CDATA[-- LevelShaper block: currency (one stat column, saved, with add / spend operations).
local Currency = {}

function Currency.declare(ctx)
	local p = ctx.params
	-- LabelKey：按玩家语言取列名（LevelShaperText）；没有就用 Label 原文
	-- LabelConfig / StartingConfig：从 GameConfig 的字段读（创作者在 Studio 改 GameConfig 照样生效）
	local cfg = ctx.gameConfig
	local label = p.Label
	if p.LabelKey and p.LabelKey ~= "" and ctx.text then
		label = ctx.text.t(p.LabelKey)
	elseif p.LabelConfig and p.LabelConfig ~= "" and cfg and type(cfg[p.LabelConfig]) == "string" then
		label = cfg[p.LabelConfig]
	end
	-- Saved = 0（塔防：每一局都从初始资金开始，金币不带到下一次进服）；缺省 / 1 = 存档，老玩法不变（审查 C2）
	ctx.stat({ key = p.Key, label = label, saved = p.Saved ~= 0, default = Currency.startingOf(ctx) })
end

-- 新玩家的起始金额：StartingConfig 指向的 GameConfig 数值优先，否则 Starting 参数
function Currency.startingOf(ctx)
	local p = ctx.params
	local cfg = ctx.gameConfig
	local starting = p.Starting or 0
	if p.StartingConfig and p.StartingConfig ~= "" and cfg and type(cfg[p.StartingConfig]) == "number" then
		starting = cfg[p.StartingConfig]
	end
	return starting
end

function Currency.start(ctx)
	local key = ctx.params.Key
	local Stats = ctx.Stats
	local mults = {}

	local function valid(n): boolean
		return type(n) == "number" and n == n and n > 0 and n < math.huge
	end

	-- 倍率连乘；某个倍率函数出错或给出非正数就当 1。
	-- Robux 商店的双倍收入（PassesServer）写在玩家属性 PassEarnMult 上：只乘赚到的（earn），补发 / 退款不吃
	local function multiplier(player): number
		local okAttr, pm = pcall(function()
			return player:GetAttribute("PassEarnMult")
		end)
		if not okAttr then
			pm = nil
		end
		local m = if type(pm) == "number" and pm > 0 and pm < math.huge then pm else 1
		for _, f in ipairs(mults) do
			local ok, v = pcall(f, player)
			if ok and type(v) == "number" and v > 0 and v < math.huge then
				m *= v
			end
		end
		return m
	end

	-- ResetOn = 事件名：这个事件一来，在线的人金额都回到起始金额（塔防输了 / 赢了新一局从头来，审查 C2）
	local resetOn = ctx.params.ResetOn
	if type(resetOn) == "string" and resetOn ~= "" then
		local starting = Currency.startingOf(ctx)
		ctx.on(resetOn, function()
			for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do
				Stats.set(pl, key, starting)
			end
		end)
	end

	ctx.provide("currency.get", function(player)
		return Stats.get(player, key)
	end)

	-- source: "earn"（默认，吃倍率）| "grant" | "refund"（原样）；返回实际加了多少
	ctx.provide("currency.add", function(player, n, source)
		if not valid(n) then
			return 0
		end
		local how = if source == "grant" or source == "refund" then source else "earn"
		local amount = if how == "earn" then math.floor(n * multiplier(player) + 0.5) else math.floor(n + 0.5)
		if amount <= 0 then
			return 0
		end
		Stats.add(player, key, amount)
		ctx.emit("currency:added", player, amount, how)
		return amount
	end)

	-- 钱够才扣，返回是否扣成
	ctx.provide("currency.spend", function(player, n)
		if type(n) ~= "number" or n ~= n or n < 0 or n == math.huge then
			return false
		end
		if Stats.get(player, key) < n then
			return false
		end
		Stats.add(player, key, -n)
		ctx.emit("currency:spent", player, n)
		return true
	end)

	-- 别的积木登记倍率（宠物、装备、重生…）：fn(player) -> number
	ctx.provide("currency.multiplier", function(fn)
		if type(fn) == "function" then
			table.insert(mults, fn)
		end
	end)
end

return Currency
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000134A">
					<Properties>
						<string name="Name">plot</string>
						<ProtectedString name="Source"><![CDATA[-- LevelShaper block: plot (one plot per player: assign on join or by touching a gate, release on leave, owner sign).
-- Scene: parts/models with BlockRole = plot (attribute PlotId = its number (a string like "3" is fine), otherwise numbered in scene order);
-- inside a plot, BlockRole = plot_sign is the owner sign and BlockRole = plot_gate is the claim gate (ClaimByTouch = 1).
-- Numbers: ReplicatedStorage > BlocksConfig > Blocks > plot. State: plot.taken / plot.free. Plot instance attribute: PlotOwner (UserId, nil when free).
-- Events: plot:claimed(player, plot), plot:released(player, plot) (sent after the game's hooks have run).
-- Operations: plot.claim(player, which?), plot.release(player), plot.owner(plot or number), plot.of(player), plot.part(id), plot.free(),
-- plot.ready(player), plot.configure(hooks) (once).
-- 玩家可见文字：LevelShaperText 里「前缀 + 键」；没有这个键就用积木自带的英文兜底（占位符 {name} 按 vars 填）
local function say(ctx, prefix: string, key: string, fallback: string, vars: { [string]: any }?): string
	local T = ctx.text
	if T then
		local got = T.t(prefix .. key, vars)
		if got ~= prefix .. key then
			return got
		end
	end
	return (string.gsub(fallback, "{(%w+)}", function(k)
		local v = vars and vars[k]
		if v == nil then
			return "{" .. k .. "}"
		end
		return tostring(v)
	end))
end

-- 头顶浮字
local function billboard(ctx, part: BasePart, text: string, color: Color3): BillboardGui
	if ctx.text and ctx.text.billboard then
		return ctx.text.billboard(part, text, color)
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 36)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 80
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Parent = bb
	bb.Parent = part
	return bb
end

-- 浮动标签的宽高：GameConfigFirst 时读 GameConfig.PadLabelSize = { 宽, 高 }，否则读积木参数
local function labelSize(ctx): (number, number)
	local g = ctx.gameConfig
	if ctx.params.GameConfigFirst == "1" and g ~= nil and type(g.PadLabelSize) == "table" then
		return g.PadLabelSize[1], g.PadLabelSize[2]
	end
	return ctx.params.LabelWidth, ctx.params.LabelHeight
end

local Plot = {}

function Plot.start(ctx)
	local Players = game:GetService("Players")
	local params = ctx.params

	-- 玩法接进来的钩子。这里保存的是玩法交过来的那张表本身（引用，不是拷贝）：玩法在 configure 之后再往表里补钩子
	-- （steal 的 onReleased 要等后面才声明的变量，所以晚一点补），plot 调用时才读，补的照样生效
	local hooks: {
		canClaim: ((Player, number) -> boolean)?,
		onClaimed: ((Player, number, Instance) -> ())?,
		onReleasing: ((Player, number, Instance) -> ())?,
		onReleased: ((Player, number, Instance) -> ())?,
		onFull: ((Player) -> ())?,
		signText: ((Player?, number) -> string)?,
	} = {}
	local function run(name: string, fn: any, ...: any): any
		local ok, res = pcall(fn, ...)
		if not ok then
			warn("[blocks] plot hook " .. name .. " failed: " .. tostring(res))
			return nil
		end
		return res
	end

	-- ---------- 地盘登记 ----------
	type Entry = {
		id: number,
		part: Instance,
		owner: Player?,
		sign: BasePart?,
		gates: { BasePart },
		gui: BillboardGui | SurfaceGui | nil,
		avatarFor: Player?,
	}
	local entries: { Entry } = {}
	local byId: { [number]: Entry } = {}
	local byPart: { [Instance]: Entry } = {}
	local ofPlayer: { [Player]: Entry } = {}
	local waiting: { Player } = {}

	local function add(inst: Instance, id: number)
		local e: Entry = { id = id, part = inst, owner = nil, sign = nil, gates = {}, gui = nil, avatarFor = nil }
		for _, d in ipairs(inst:GetDescendants()) do
			local role = d:GetAttribute("BlockRole")
			if d:IsA("BasePart") then
				if role == "plot_sign" and not e.sign then
					e.sign = d
				elseif role == "plot_gate" then
					table.insert(e.gates, d)
				end
			end
		end
		table.insert(entries, e)
		byId[id] = e
		byPart[inst] = e
	end
	local used: { [number]: boolean } = {}
	local unnumbered: { Instance } = {}
	for _, inst in ipairs(ctx.find("plot")) do
		-- PlotId 属性：序列化只能存字符串，所以先转成数字
		local id = tonumber(inst:GetAttribute("PlotId"))
		if id ~= nil and id >= 1 and id == math.floor(id) and not used[id] then
			used[id] = true
			add(inst, id)
		else
			table.insert(unnumbered, inst)
		end
	end
	local nextId = 1
	for _, inst in ipairs(unnumbered) do
		while used[nextId] do
			nextId += 1
		end
		used[nextId] = true
		add(inst, nextId)
	end
	table.sort(entries, function(a: Entry, b: Entry)
		return a.id < b.id
	end)
	if #entries == 0 then
		warn("[blocks] plot: no part with BlockRole = plot in the scene")
	end

	local function lookup(which: any): Entry?
		if typeof(which) == "Instance" then
			return byPart[which]
		elseif type(which) == "number" then
			return byId[which]
		end
		return nil
	end
	local function freeCount(): number
		local n = 0
		for _, e in ipairs(entries) do
			if not e.owner then
				n += 1
			end
		end
		return n
	end

	local hasState = ctx.has("state.set")
	local function publish()
		if hasState then
			local free = freeCount()
			ctx.call("state.set", "plot.taken", #entries - free)
			ctx.call("state.set", "plot.free", free)
		end
	end

	-- ---------- 主人牌 ----------
	local function renderSign(e: Entry)
		local sign = e.sign
		if not sign then
			return
		end
		local owner = e.owner
		local text: any = nil
		if hooks.signText then
			text = run("signText", hooks.signText, owner, e.id)
		end
		if type(text) ~= "string" then
			text = if owner
				then say(ctx, "plot_", "sign", "{player}'s plot", { player = owner.DisplayName })
				else say(ctx, "plot_", "free", "Free plot")
		end
		if not e.gui then
			if params.SignStyle == 1 then
				-- 头顶浮字牌：名字在右、主人头像在左
				local og = billboard(ctx, sign, text, Color3.fromRGB(255, 214, 90))
				og.Name = "OwnerGui"
				og.StudsOffset = Vector3.new(0, 2.5, 0)
				og.Size = UDim2.fromOffset(280, 48)
				local nameLabel = og:FindFirstChildOfClass("TextLabel") :: TextLabel
				nameLabel.Position = UDim2.fromScale(0.2, 0)
				nameLabel.Size = UDim2.fromScale(0.8, 1)
				local avatar = Instance.new("ImageLabel")
				avatar.Name = "Avatar"
				avatar.Size = UDim2.fromScale(0.17, 1)
				avatar.BackgroundTransparency = 1
				avatar.Visible = false
				avatar.Parent = og
				Instance.new("UICorner", avatar).CornerRadius = UDim.new(0.5, 0)
				e.gui = og
			else
				-- 贴在牌子背面的字（朝向出生点的那一面是 Back）
				local gui = Instance.new("SurfaceGui")
				gui.Name = "SignGui"
				gui.Face = Enum.NormalId.Back
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.PixelsPerStud = 40
				local label = Instance.new("TextLabel")
				label.Name = "Text"
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				if ctx.text and ctx.text.font then
					label.Font = ctx.text.font
				end
				label.TextScaled = true
				label.TextColor3 = Color3.new(1, 1, 1)
				label.Parent = gui
				gui.Parent = sign
				e.gui = gui
			end
		end
		local gui = e.gui :: Instance
		local label = gui:FindFirstChildOfClass("TextLabel") :: TextLabel
		label.Text = text
		-- 主人的头像（换了主人才重新取；取不到就只有名字）
		local avatar = gui:FindFirstChild("Avatar") :: ImageLabel?
		if avatar and e.avatarFor ~= owner then
			e.avatarFor = owner
			avatar.Image = ""
			avatar.Visible = false
			if owner then
				task.spawn(function()
					local ok, img = pcall(function()
						return Players:GetUserThumbnailAsync(owner.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
					end)
					if ok and e.owner == owner then
						avatar.Image = img
						avatar.Visible = true
					end
				end)
			end
		end
	end

	-- ---------- 认领 / 释放 ----------
	local function removeWaiting(player: Player)
		local i = table.find(waiting, player)
		if i then
			table.remove(waiting, i)
		end
	end
	local function notifyFull(player: Player)
		if hooks.onFull then
			run("onFull", hooks.onFull, player)
		else
			-- 没有玩法提示时，最近一条放在玩家属性上（PlotNotice + 序号，组合局的 HUD 读）：排队的人知道要等、不排队的人知道没地了
			local text = if params.Queue ~= 0
				then say(ctx, "plot_", "full_queue", "All plots are taken - wait here, you get the next free plot")
				else say(ctx, "plot_", "full", "All plots are taken")
			player:SetAttribute("PlotNotice", text) -- internal
			player:SetAttribute("PlotNoticeSeq", (player:GetAttribute("PlotNoticeSeq") or 0) + 1) -- internal
		end
	end

	-- 玩法说「现在不能认领」（canClaim 返回 false，比如存档还没读完）时记下请求，不丢：
	-- 踩门认领记下是哪个门（pendingGate），其余记下要哪块（held，which = nil 表示随便一块）；玩法放行后调 plot.ready 补
	local pendingGate: { [Player]: { entry: Entry, gate: BasePart } } = {}
	local held: { [Player]: { which: any } } = {}
	local function allowed(player: Player, id: number): boolean
		if not hooks.canClaim then
			return true
		end
		return if run("canClaim", hooks.canClaim, player, id) then true else false
	end

	-- 真正登记主人：钩子先跑完，再发事件（订阅 plot:claimed 的人看到的是玩法已经收拾好的状态）
	local function assignTo(player: Player, e: Entry)
		removeWaiting(player)
		held[player] = nil
		pendingGate[player] = nil
		e.owner = player
		ofPlayer[player] = e
		e.part:SetAttribute("PlotOwner", player.UserId) -- internal
		renderSign(e)
		publish()
		if hooks.onClaimed then
			run("onClaimed", hooks.onClaimed, player, e.id, e.part)
		end
		ctx.emit("plot:claimed", player, e.id)
	end

	-- 认领：which = 地盘编号 / 地盘实例（要空着才给），nil = 第一块空的。主人已经有地盘就原样返回；
	-- 玩法的 canClaim 说不行（读档没完成）就不认领、记下请求，plot.ready 再补；没有空的就排队（Queue = 1）并提示
	local function claim(player: Player, which: any): number?
		local have = ofPlayer[player]
		if have then
			return have.id
		end
		if not player.Parent then
			return nil
		end
		local e: Entry? = nil
		if which ~= nil then
			e = lookup(which)
			if e and e.owner then
				e = nil
			end
		else
			for _, x in ipairs(entries) do
				if not x.owner then
					e = x
					break
				end
			end
		end
		if not e then
			-- 指定的那块被别人占了：什么都不说；没指定而一块都不剩：排队（Queue = 1）并提示
			if which == nil then
				if params.Queue ~= 0 and not table.find(waiting, player) then
					table.insert(waiting, player)
				end
				notifyFull(player)
			end
			return nil
		end
		if not allowed(player, e.id) then
			held[player] = { which = which }
			return nil
		end
		assignTo(player, e)
		return e.id
	end

	local function release(player: Player): number?
		removeWaiting(player)
		held[player] = nil
		pendingGate[player] = nil
		local e = ofPlayer[player]
		if not e then
			return nil
		end
		-- 主人还在登记里时先给玩法收拾（比如读出已购清单），再空出来
		if hooks.onReleasing then
			run("onReleasing", hooks.onReleasing, player, e.id, e.part)
		end
		e.owner = nil
		ofPlayer[player] = nil
		e.part:SetAttribute("PlotOwner", nil) -- internal
		renderSign(e)
		publish()
		if hooks.onReleased then
			run("onReleased", hooks.onReleased, player, e.id, e.part)
		end
		ctx.emit("plot:released", player, e.id)
		-- 空出来的这块给排队最久、而且玩法放行的人（没放行的留在队里，放行后 plot.ready 再认领）
		local i = 1
		while i <= #waiting do
			local nextPlayer = waiting[i]
			if not nextPlayer.Parent then
				table.remove(waiting, i)
			elseif allowed(nextPlayer, e.id) then
				table.remove(waiting, i)
				assignTo(nextPlayer, e)
				break
			else
				i += 1
			end
		end
		return e.id
	end

	-- ---------- 踩门认领（ClaimByTouch = 1） ----------
	local function tryClaimAt(player: Player, e: Entry, gate: BasePart)
		if e.owner or ofPlayer[player] then
			return
		end
		if not allowed(player, e.id) then
			pendingGate[player] = { entry = e, gate = gate }
			return
		end
		assignTo(player, e)
	end
	if params.ClaimByTouch == 1 then
		for _, e in ipairs(entries) do
			for _, gate in ipairs(e.gates) do
				gate.Touched:Connect(function(hit)
					local character = hit:FindFirstAncestorOfClass("Model")
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					if not humanoid or humanoid.Health <= 0 then
						return
					end
					local player = Players:GetPlayerFromCharacter(character)
					if player then
						tryClaimAt(player, e, gate)
					end
				end)
			end
		end
	end

	-- 玩法放行之后（读档完成）补认领：踩门被拦的，玩家还站在那个门边（RetryRadius 以内）才算；
	-- 其余被拦的（进服分配、玩法自己调的 claim）按原来的请求再认领一次，排着队的也在这里领；返回现在拥有的地盘编号
	local function ready(player: Player): number?
		local have = ofPlayer[player]
		if have then
			return have.id
		end
		local pending = pendingGate[player]
		if pending then
			pendingGate[player] = nil
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (root.Position - pending.gate.Position).Magnitude <= params.RetryRadius then
				tryClaimAt(player, pending.entry, pending.gate)
				local e = ofPlayer[player]
				return if e then e.id else nil
			end
			return nil
		end
		local h = held[player]
		if h ~= nil or table.find(waiting, player) then
			held[player] = nil
			return claim(player, if h then h.which else nil)
		end
		return nil
	end

	-- ---------- 进服 / 离开 ----------
	-- 进服分配（AutoAssign = 1）要等所有积木都启动完（blocks:ready）：玩法的钩子（canClaim / onClaimed …）是它们的 start 里才接上的，
	-- 在这之前分配会漏掉钩子。blocks:ready 之前进来的人在启动时统一分配（GetPlayers 里已经有了）
	local started = false
	if params.AutoAssign == 1 then
		Players.PlayerAdded:Connect(function(player)
			if started then
				claim(player, nil)
			end
		end)
		ctx.on("blocks:ready", function()
			started = true
			for _, player in ipairs(Players:GetPlayers()) do
				claim(player, nil)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		pendingGate[player] = nil
		held[player] = nil
		if params.AutoRelease ~= 0 then
			release(player)
		else
			removeWaiting(player) -- 玩法自己调 plot.release 时，排队的人也不能留着已经走了的
			-- 兜底：玩法漏了 release，地盘就永远被一个走了的人占着。等玩法的 PlayerRemoving 都跑完（defer）还在就警告并释放
			task.defer(function()
				if ofPlayer[player] then
					warn("[blocks] plot: AutoRelease = 0 but the game did not release the plot of a player who left; releasing it")
					release(player)
				end
			end)
		end
	end)

	-- ---------- 操作 ----------
	ctx.provide("plot.claim", claim)
	ctx.provide("plot.release", release)
	-- 地盘可以按编号或按实例（地盘模型 / 零件）查
	ctx.provide("plot.owner", function(which: any): Player?
		local e = lookup(which)
		return if e then e.owner else nil
	end)
	ctx.provide("plot.of", function(player: Player): number?
		local e = ofPlayer[player]
		return if e then e.id else nil
	end)
	ctx.provide("plot.part", function(id: number): Instance?
		local e = byId[id]
		return if e then e.part else nil
	end)
	ctx.provide("plot.free", freeCount)
	ctx.provide("plot.ready", ready)
	local configured = false
	ctx.provide("plot.configure", function(h)
		if configured then
			warn("[blocks] plot.configure was already called; the second call is ignored")
			return
		end
		configured = true
		hooks = h or {}
		-- 玩法的牌子文字这时才有：所有地盘的主人牌按现状重画一遍
		for _, e in ipairs(entries) do
			renderSign(e)
		end
	end)

	publish()
end

return Plot
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000000000000000000000000134B">
					<Properties>
						<string name="Name">steal</string>
						<ProtectedString name="Source"><![CDATA[-- LevelShaper block: steal core (the runway, bases, buying, income, stealing and base locks).
-- Started by the blocks boot (StealServer). The cash column comes from the currency block;
-- this block adds the steals column and saves base / level / seen / speed next to it (save store and field names unchanged).
-- Every name, price and number lives in ReplicatedStorage.GameConfig.
-- 存档字段读到的原值：存档读完（loaded）后整份交给 start 里的 loadRef
local raw: { [Player]: { [string]: any } } = {}
local pending: { [Player]: boolean } = {}
local loadRef: ((Player, { [string]: any }) -> ())? = nil
local saveRef: ((Player) -> { [string]: any })? = nil
local Core = {}

function Core.declare(ctx)
	ctx.stat({ key = "steals", label = ctx.text and ctx.text.t("stat_steals") or "Steals", saved = true })
	-- 四个存档字段（字面量写出来，积木校验才对得上 persistence）
	local function fieldHooks(field: string)
		return {
			load = function(player: Player, v)
				local d = raw[player] or {}
				raw[player] = d
				d[field] = v
			end,
			dump = function(player: Player)
				return if saveRef then saveRef(player)[field] else nil
			end,
		}
	end
	ctx.persist("base", fieldHooks("base"))
	ctx.persist("level", fieldHooks("level"))
	ctx.persist("seen", fieldHooks("seen"))
	ctx.persist("speed", fieldHooks("speed"))
	ctx.loaded(function(player: Player)
		if loadRef then
			local data = raw[player] or {}
			raw[player] = nil
			loadRef(player, data)
		else
			pending[player] = true
		end
	end)
end

function Core.start(ctx)
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local ServerScriptService = game:GetService("ServerScriptService")
	local ServerStorage = game:GetService("ServerStorage")
	local RunService = game:GetService("RunService")
	local StarterPlayer = game:GetService("StarterPlayer")
	local CollectionService = game:GetService("CollectionService")

	local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
	local Text = require(ReplicatedStorage:WaitForChild("LevelShaperText"))
	local Mods = ServerScriptService:WaitForChild("LevelShaperModules")
	local Stats = require(Mods:WaitForChild("Stats"))

	local templates = ServerStorage:WaitForChild("StealCreatures")
	local basesFolder = workspace:WaitForChild("Bases")
	local remote = Instance.new("RemoteEvent")
	remote.Name = "StealEvent"
	remote.Parent = ReplicatedStorage

	local preview = workspace:FindFirstChild("PreviewCreatures")
	if preview then
		preview:Destroy()
	end
	local runwayFolder = Instance.new("Folder")
	runwayFolder.Name = "RunwayCreatures"
	runwayFolder.Parent = workspace

	local WALK = StarterPlayer.CharacterWalkSpeed
	local byName = {}
	for _, c in ipairs(Config.Creatures) do
		byName[c.Name] = c
	end
	local function vars(extra: { [string]: any }?): { [string]: any }
		local v = { cash = Config.CurrencyName, creature = Config.CreatureName }
		for k, x in pairs(extra or {}) do
			v[k] = x
		end
		return v
	end
	local function toast(player: Player, key: string, extra: { [string]: any }?, color: string?)
		remote:FireClient(player, "toast", Text.t(key, vars(extra)), color)
	end

	-- ---------- 突变（Golden / Diamond / Rainbow：售价、收入、卖回价 × 倍数） ----------
	local MUT = {}
	for _, m in ipairs(Config.Mutations or {}) do
		MUT[m.Id] = m
	end
	local function mult(mut: string?): number
		local m = mut and MUT[mut]
		return if m then m.Mult else 1
	end
	-- 突变风暴：这段时间里概率 × MutationStormBoost
	local stormUntil = 0
	local function rollMutation(): string?
		local boost = if workspace:GetServerTimeNow() < stormUntil then Config.MutationStormBoost else 1
		local r = math.random()
		local acc = 0
		for _, m in ipairs(Config.Mutations or {}) do
			acc += m.Chance * boost
			if r < acc then
				return m.Id
			end
		end
		return nil
	end
	-- 存档里一只 = "名字" 或 "名字|突变"（突变关掉 / 不认识的档位：只留名字）
	local function keyOf(name: string, mut: string?): string
		return if mut then name .. "|" .. mut else name
	end
	-- 给玩家看的名字：突变的在前面加档名（Golden Bouncy Blob）
	local function shownName(name: string, mut: string?): string
		if not mut then
			return name
		end
		local key = "mut_" .. mut -- internal
		return Text.t(key) .. " " .. name
	end
	-- 稀有度的刷出权重：GameConfig 顶层的 WeightCommon … WeightMythic（创作者在这里改）
	local WEIGHT_KEY = { common = "WeightCommon", rare = "WeightRare", epic = "WeightEpic", legendary = "WeightLegendary", mythic = "WeightMythic" }
	local function weightOf(rarity: string): number
		local k = WEIGHT_KEY[rarity]
		return (k and Config[k]) or (Config.Rarity[rarity] and Config.Rarity[rarity].Weight) or 1
	end
	-- 卖回价：跑道的突变按倍数卖（买价同样乘了倍数）；转盘 / 种菜不乘突变、再乘 SellScale ——「转了就卖」不赚钱（审查 I1）
	local function sellValue(c, mut: string?): number
		local m = if Config.Source == "runway" then mult(mut) else 1
		return math.floor((c and c.Price or 0) * m * Config.SellRatio * (Config.SellScale or 1))
	end
	local function parseKey(k: string): (string, string?)
		local n, m = string.match(k, "^(.-)|(%a+)$")
		if n then
			return n, if MUT[m] then m else nil
		end
		return k, nil
	end

	-- ---------- 基地 ----------
	type Owned = { name: string, model: Model, root: BasePart, rootLocal: CFrame, slot: number, base: number, stolenBy: Player?, readyAt: number?, mut: string?, keep: string? }
	type Base = {
		index: number,
		model: Model,
		floor: BasePart,
		slots: { BasePart },
		creatures: { [number]: Owned },
		pending: number,
		lockedUntil: number,
		lockReadyAt: number,
		inward: number,
		level: number,
		-- 散落局（wild）的「场地」：没有主人，站位 = 各区域的台子；不在 bases 里（不分配给玩家）
		wild: boolean?,
	}
	local bases: { Base } = {}
	-- 谁拥有哪块基地由 plot 积木管（BlockRole = plot）：owner 用 plot.owner(基地模型)，玩家的基地用 plot.of(玩家) 取到地盘、再按实例查 baseByModel。
	-- 基地号只有一个来源——基地模型里的 BaseId（客户端也认它）；plot 的 PlotId 只用来给 plot 排序，这里不拿它当基地号（审查 I6）。
	-- 散落局的「场地」(wild) 不分配给玩家，没有主人
	local baseByModel: { [Instance]: Base } = {}
	local upgradeOf: { [Base]: (Player) -> () } = {} -- 每块基地的升级台处理函数（升级台那段里填）
	local function ownerOf(b: Base): Player?
		if b.wild then
			return nil
		end
		return ctx.call("plot.owner", b.model)
	end
	local function baseOf(player: Player): number?
		local id = ctx.call("plot.of", player)
		local part = if id then ctx.call("plot.part", id) else nil
		local b = if part then baseByModel[part] else nil
		return if b then b.index else nil
	end
	-- 最近一次基地里的角色名单（存档用；玩家离开时基地先清空也不丢）
	local roster: { [Player]: { string } } = {}
	-- 排队等基地的人带着的存档名单（plot 积木排队，轮到时 onClaimed 里取）
	local claimNames: { [Player]: { string } } = {}
	-- 存档里有、这次放不下（创作者把位置改少了）或不认识（改名 / 删掉了）的角色：原样留在存档里，不抹掉（审查 I3）
	local overflow: { [Player]: { string } } = {}
	-- 基地等级（存档用；玩家离开时基地先回到 1 层也不丢）与图鉴（见过的："名字" 与 "名字|突变"）
	local levelOf: { [Player]: number } = {}
	-- 存档里的等级原样留着：创作者把楼层改少了，等级照样存回去，以后改回来还在（审查 I2）
	local levelSaved: { [Player]: number } = {}
	-- 读档放角色时先不推图鉴（老存档没有 seen，每放一只推一次整张表），放完一次推（审查 M11）
	local loadingSeen: { [Player]: boolean } = {}
	local seen: { [Player]: { [string]: boolean } } = {}
	-- 散落局的跑速等级（跑速台升级、存档）；其它来源恒为 0
	local speedLv: { [Player]: number } = {}

	for _, m in ipairs(basesFolder:GetChildren()) do
		local id = m:FindFirstChild("BaseId")
		local floor = m:FindFirstChild("BaseFloor")
		if id and floor then
			local slots = {}
			for _, s in ipairs(m.Slots:GetChildren()) do
				slots[s.Index.Value] = s
			end
			local base: Base = {
				index = id.Value,
				model = m,
				floor = floor,
				slots = slots,
				creatures = {},
				pending = 0,
				lockedUntil = 0,
				lockReadyAt = 0,
				inward = if floor.Position.Z > 0 then 1 else -1,
				level = 1,
			}
			bases[id.Value] = base
			baseByModel[m] = base
			-- 客户端按它判断「这是不是我的基地」（升级提示只给主人看）
			m:SetAttribute("Base", id.Value) -- internal
		end
	end

	local function now(): number
		return workspace:GetServerTimeNow()
	end

	local function inside(b: Base, pos: Vector3): boolean
		local f = b.floor
		local half = f.Size / 2
		local d = pos - f.Position
		-- 高度覆盖 3 层（每层 10）
		return math.abs(d.X) <= half.X and math.abs(d.Z) <= half.Z and d.Y > -2 and d.Y < 30
	end

	local function snapshot(b: Base): { string }
		local out = {}
		for k = 1, #b.slots do
			local o = b.creatures[k]
			if o then
				-- 读档时这一局不认的突变（创作者关掉了）原样存回去，以后打开还在（审查 I2）
				table.insert(out, o.keep or keyOf(o.name, o.mut))
			end
		end
		return out
	end
	local function remember(b: Base)
		local owner = ownerOf(b)
		if owner then
			roster[owner] = snapshot(b)
		end
	end

	local function income(b: Base): number
		local n = 0
		for _, o in pairs(b.creatures) do
			-- 被扛着的、还没长成的（种菜）不生钱
			if not o.stolenBy and not o.readyAt then
				local c = byName[o.name]
				n += if c then c.Income * mult(o.mut) else 0
			end
		end
		return n
	end

	-- 主人牌（名字 + 头像）由 plot 积木画（signText 钩子给文字）；这里管升级台、收款牌和基地属性
	local function label(b: Base)
		if b.wild then
			return
		end
		local owner = ownerOf(b)
		local station = b.model:FindFirstChild("UpgradeStation")
		local ug = station and station:FindFirstChild("UpgradeGui")
		if ug then
			local nextCost = Config.LevelCosts[b.level + 1]
			ug.TextLabel.Text = if not owner then "" elseif nextCost then table.concat({ Text.t("level_label", { n = b.level, max = Config.Levels }), Text.t("upgrade", vars({ n = nextCost })) }, "\n") else Text.t("max_level")
			local up = station:FindFirstChild("UpgradePrompt") :: ProximityPrompt?
			if up then
				-- 显隐由客户端定（只给主人看）；服务器只说「现在能不能升」
				up:SetAttribute("ServerOn", owner ~= nil and nextCost ~= nil) -- internal
				up.ObjectText = if nextCost then Text.t("price", vars({ n = nextCost })) else ""
			end
		end
		b.model:SetAttribute("Level", b.level) -- internal
		local pad = b.model:FindFirstChild("CollectPad")
		local pg = pad and pad:FindFirstChild("PendingGui")
		if pg then
			pg.TextLabel.Text = if owner then Text.t("collected", vars({ n = math.floor(b.pending) })) else ""
		end
		b.model:SetAttribute("Owner", if owner then owner.UserId else nil) -- internal
		b.model:SetAttribute("Income", income(b)) -- internal
		b.model:SetAttribute("LockedUntil", b.lockedUntil) -- internal
		b.model:SetAttribute("LockReadyAt", b.lockReadyAt) -- internal
	end

	-- ---------- 角色模型 ----------
	-- 模板建在原点（脚底中心、面朝 -Z）：其余零件焊到 CreatureRoot 上，只锚住它，挪它就整只一起动
	local function spawnModel(name: string, template: string?, mut: string?): (Model?, BasePart?, CFrame?)
		local c = byName[name]
		local tpl = c and templates:FindFirstChild(template or c.Template)
		if not tpl then
			return nil
		end
		local m = tpl:Clone()
		local root = m:FindFirstChild("CreatureRoot") :: BasePart
		if not root then
			m:Destroy()
			return nil
		end
		local rootLocal = root.CFrame
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d ~= root then
				d.Anchored = false
				d.Massless = true
				d.CanCollide = false
				d.CanQuery = false
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = d
				w.Parent = d
			end
		end
		root.Anchored = true
		root.CanCollide = false
		root.Massless = true
		-- 突变外观：身体换成突变色（眼睛的黑白不动），根上加同色的光和闪光；彩虹由客户端轮换颜色
		local m0 = mut and MUT[mut]
		if m0 then
			m:SetAttribute("Mutation", mut) -- internal
			-- 蛋网格皮（EggSkin，顶点色 × Color）：只染体积最大的那块（壳），花纹、底座不动，不然方块蛋隐身后看不出突变
			local shell: BasePart? = nil
			local shellVol = 0
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") and d.Name == "EggSkin" then
					local vol = d.Size.X * d.Size.Y * d.Size.Z
					if vol > shellVol then
						shell, shellVol = d, vol
					end
				end
			end
			for _, d in ipairs(m:GetDescendants()) do
				if d == shell then
					d.Color = m0.Color
					if mut == "golden" then
						d.Material = Enum.Material.Metal
						d.Reflectance = 0.25
					elseif mut == "diamond" then
						d.Material = Enum.Material.Glass
					end
				end
				if d:IsA("BasePart") and d.Name == "CreaturePart" then
					local col = d.Color
					local sum = col.R + col.G + col.B
					if sum > 0.4 and sum < 2.9 then
						d.Color = m0.Color
						if mut == "golden" then
							d.Material = Enum.Material.Metal
							d.Reflectance = 0.25
						elseif mut == "diamond" then
							d.Material = Enum.Material.Glass
							d.Transparency = math.max(d.Transparency, 0.15)
						else
							d.Material = Enum.Material.Neon
						end
					end
				end
			end
			local light = Instance.new("PointLight")
			light.Color = m0.Color
			light.Brightness = 2
			light.Range = 10
			light.Parent = root
			local sp = Instance.new("Sparkles")
			sp.SparkleColor = m0.Color
			sp.Parent = root
			if mut == "rainbow" then
				CollectionService:AddTag(m, "StealRainbow")
			end
		end
		-- 名牌：（突变）名字 + 稀有度（颜色）+ 每秒收入
		local rarity = Config.Rarity[c.Rarity]
		local bb = Instance.new("BillboardGui")
		bb.Name = "Tag"
		bb.Size = UDim2.fromOffset(170, 54)
		-- 封顶 3.6：楼上楼板底面离脚底 8.6，mythic 的名牌原来正好嵌进楼板（审查 I3）
		bb.StudsOffset = Vector3.new(0, math.min(root.Size.Y / 2 + 1.6, 3.6), 0)
		-- 不透墙显示：跑道上一排名牌叠在一起、隔着基地墙也看得见会很乱
		bb.MaxDistance = 55
		bb.AlwaysOnTop = false
		local top = Instance.new("TextLabel")
		top.Size = UDim2.new(1, 0, 0.55, 0)
		top.BackgroundTransparency = 1
		top.Text = shownName(c.Name, mut)
		top.TextScaled = true
		top.Font = Text.font
		top.TextColor3 = if m0 then m0.Color else Color3.new(1, 1, 1)
		top.TextStrokeTransparency = 0.3
		top.Parent = bb
		local sub = top:Clone()
		sub.Name = "Sub"
		sub.Position = UDim2.fromScale(0, 0.55)
		sub.Size = UDim2.new(1, 0, 0.45, 0)
		local rarityKey = "rarity_" .. c.Rarity -- internal
		sub.Text = Text.t(rarityKey) .. "  " .. Text.t("income", vars({ n = c.Income * mult(mut) }))
		sub.TextColor3 = if rarity then rarity.Color else Color3.new(1, 1, 1)
		sub.Parent = bb
		bb.Parent = root
		return m, root, rootLocal
	end

	local function footTo(root: BasePart, rootLocal: CFrame, foot: CFrame)
		root.CFrame = foot * rootLocal
	end

	-- 刚克隆、还没进 Workspace 的模型：焊接要进了 Workspace 才按当时的位置生效，这时只挪根零件身体会留在原点
	-- （2026-10-11 工单「偷来的 Boo 看不见、不在手上」：身体全留在地图原点），所以整只一起挪
	local function spawnAt(m: Model, root: BasePart, rootLocal: CFrame, foot: CFrame)
		m:PivotTo(foot * rootLocal * root.CFrame:Inverse() * m:GetPivot())
	end

	local function slotFoot(b: Base, k: number): CFrame
		local s = b.slots[k]
		-- 面朝入口（北排朝 -z，南排朝 +z）；场地台子上的面朝地图中线（基地那边）
		local yaw = if b.wild then (if s.Position.X > 0 then math.pi / 2 else -math.pi / 2) elseif b.inward > 0 then 0 else math.pi
		return CFrame.new(s.Position + Vector3.new(0, s.Size.Y / 2, 0)) * CFrame.Angles(0, yaw, 0)
	end

	-- 解锁的站位：1..SlotCount × 等级
	local function openSlots(b: Base): number
		return math.min(#b.slots, Config.SlotCount * b.level)
	end
	local function freeSlot(b: Base): number?
		for k = 1, openSlots(b) do
			if not b.creatures[k] then
				return k
			end
		end
		return nil
	end

	local function prompt(parent: Instance, name: string, action: string, object: string, hold: number): ProximityPrompt
		local p = Instance.new("ProximityPrompt")
		p.Name = name
		p.ActionText = action
		p.ObjectText = object
		p.HoldDuration = hold
		p.MaxActivationDistance = 10
		p.RequiresLineOfSight = false
		p.Parent = parent
		return p
	end

	local stealCreature
	local sellCreature

	-- 放进基地的第 k 个位置（买到 / 偷到 / 读档）
	local function markSeen(player: Player?, name: string, mut: string?)
		local s = player and seen[player]
		if not s then
			return
		end
		local fresh = not s[name] or (mut ~= nil and not s[keyOf(name, mut)])
		s[name] = true
		if mut then
			s[keyOf(name, mut)] = true
		end
		if fresh and not loadingSeen[player :: Player] then
			local list = {}
			for key in pairs(s) do
				table.insert(list, key)
			end
			remote:FireClient(player :: Player, "seen", list)
		end
	end

	local function place(b: Base, k: number, name: string, mut: string?, keep: string?): Owned?
		local m, root, rootLocal = spawnModel(name, nil, mut)
		if not m then
			return nil
		end
		spawnAt(m, root :: BasePart, rootLocal :: CFrame, slotFoot(b, k))
		local o: Owned = { name = name, model = m, root = root :: BasePart, rootLocal = rootLocal :: CFrame, slot = k, base = b.index, stolenBy = nil, mut = mut, keep = keep }
		b.creatures[k] = o
		local c = byName[name]
		markSeen(ownerOf(b), name, mut)
		-- 不能偷的变体（转盘 / 种菜缺省）不挂偷的提示
		if Config.Stealing or b.wild then
			local sp = prompt(root :: BasePart, "StealPrompt", Text.t(if b.wild then "wild_grab" else "steal"), name, Config.StealHoldSeconds)
			-- 8 以内才显示：楼上的人看不到正下方楼下的（上下两层相距约 9.4，审查 M2）
			sp.MaxActivationDistance = 8
			sp.Triggered:Connect(function(player)
				stealCreature(player, b, o)
			end)
		end
		if not b.wild then
			local sellP = prompt(root :: BasePart, "SellPrompt", Text.t("sell", { n = sellValue(c, mut) }), name, 0.5)
			sellP.MaxActivationDistance = 8
			sellP.Triggered:Connect(function(player)
				sellCreature(player, b, o)
			end)
		end
		m:SetAttribute("Base", b.index) -- internal
		m:SetAttribute("Slot", k) -- internal
		m.Parent = b.model
		remember(b)
		label(b)
		return o
	end

	local function unplace(b: Base, o: Owned)
		if b.creatures[o.slot] == o then
			b.creatures[o.slot] = nil
		end
		remember(b)
		label(b)
	end

	local function fmtTime(s: number): string
		s = math.max(0, math.ceil(s))
		return string.format("%d:%02d", s // 60, s % 60)
	end

	-- 种菜：先种一棵小苗（占位、进存档名单、不生钱），按稀有度等 GrowSeconds × 2^档位 长成
	local GROW_TIER = { common = 1, rare = 2, epic = 4, legendary = 8, mythic = 16 }
	local function plant(b: Base, k: number, name: string, owner: Player, mut: string?): boolean
		local c = byName[name]
		local m, root, rootLocal = spawnModel(name, "Sprout")
		if not m or not c then
			return false
		end
		spawnAt(m, root :: BasePart, rootLocal :: CFrame, slotFoot(b, k))
		local grow = Config.GrowSeconds * (GROW_TIER[c.Rarity] or 1)
		local o: Owned = { name = name, model = m, root = root :: BasePart, rootLocal = rootLocal :: CFrame, slot = k, base = b.index, stolenBy = nil, readyAt = now() + grow, mut = mut }
		b.creatures[k] = o
		local tag = (root :: BasePart):FindFirstChild("Tag")
		m:SetAttribute("Base", b.index) -- internal
		m.Parent = b.model
		remember(b)
		label(b)
		toast(owner, "planted", { t = fmtTime(grow) })
		task.spawn(function()
			while b.creatures[k] == o and now() < (o.readyAt :: number) do
				if tag then
					tag.TextLabel.Text = Text.t("growing", { t = fmtTime((o.readyAt :: number) - now()) })
					tag.Sub.Text = ""
				end
				task.wait(0.5)
			end
			-- 长成：换成真正的植物（主人还在、这一格还是它）
			if b.creatures[k] == o then
				o.model:Destroy()
				b.creatures[k] = nil
				if ownerOf(b) == owner then
					place(b, k, name, mut)
					toast(owner, "grown", { name = shownName(name, mut) })
				end
			end
		end)
		return true
	end

	-- ---------- 楼层（2 层、3 层按主人的等级显示；没解锁的平台、坡道、墙、站位隐身且穿得过去） ----------
	local function showPart(p: BasePart, on: boolean)
		if p:GetAttribute("T0") == nil then
			p:SetAttribute("T0", p.Transparency) -- internal
			p:SetAttribute("C0", p.CanCollide) -- internal
		end
		p.Transparency = if on then p:GetAttribute("T0") else 1
		p.CanCollide = if on then p:GetAttribute("C0") else false
		p.CanQuery = on
		p.CanTouch = on
	end
	local function setLevel(b: Base, level: number)
		b.level = math.clamp(level, 1, Config.Levels)
		for lv = 2, 3 do
			local f = b.model:FindFirstChild("Level" .. lv)
			if f then
				for _, d in ipairs(f:GetDescendants()) do
					if d:IsA("BasePart") then
						showPart(d, lv <= b.level)
					end
				end
			end
		end
		for k, s in pairs(b.slots) do
			showPart(s, k <= openSlots(b))
		end
		label(b)
	end
	for _, b in ipairs(bases) do
		setLevel(b, 1)
	end

	-- ---------- 分配基地 ----------
	-- 谁拿哪块由 plot 积木定（先到先得、满了排队）；轮到这个人时在 onClaimed 里把存档名单放进基地。
	-- 基地编号单独发一条（客户端据此画箭头 / 高亮牌子）：这部分是 steal 自己的客户端表现，没有放进 plot 积木
	local function onClaimed(player: Player, _plotId: number, part: Instance)
		local b = baseByModel[part]
		if not b then
			warn(string.format("[blocks] steal: plot %s is not a base (no BaseId / BaseFloor)", part.Name))
			return
		end
		-- 存档名单（刚读完档、排队轮到时带着）优先；没有就是「中途释放又认领」：用最近一次基地里的角色，加上放不下 / 不认识的那些（审查 I1）
		local names = claimNames[player]
		if not names then
			names = table.clone(roster[player] or {})
			for _, n in ipairs(overflow[player] or {}) do
				table.insert(names, n)
			end
		end
		claimNames[player] = nil
		b.pending = 0
		b.lockedUntil = 0
		b.lockReadyAt = 0
		player:SetAttribute("StealBase", b.index) -- internal
		setLevel(b, levelOf[player] or 1)
		local extra = {}
		loadingSeen[player] = true
		for _, key in ipairs(names) do
			local k = freeSlot(b)
			local name, mut = parseKey(key)
			if k and byName[name] then
				-- 存档里带着这一局不认的突变：照样放（不带突变），存档时原样写回
				place(b, k, name, mut, if mut == nil and key ~= name then key else nil)
			else
				table.insert(extra, key)
			end
		end
		loadingSeen[player] = nil
		local list = {}
		for key in pairs(seen[player] or {}) do
			table.insert(list, key)
		end
		remote:FireClient(player, "seen", list)
		overflow[player] = extra
		remember(b)
		label(b)
		toast(player, "base_yours")
		-- 进服瞬间客户端可能还没连上，所以客户端连上后会发 "ready" 再要一次（见下面的 OnServerEvent）
		remote:FireClient(player, "base", b.index)
	end
	-- onReleased（基地收拾）要用到后面才声明的 carrying / speed，所以钩子表先交出去、等声明完再补上这一项（plot 积木调用时才读）
	local plotHooks = {
		-- 存档读完才能认领（读档放角色、等级都要读到存档）；没读完 plot 积木记下请求，读完（assign 里 defer）plot.ready 再补
		canClaim = function(player: Player): boolean
			return Stats.ready(player)
		end,
		onClaimed = onClaimed,
		onFull = function(player: Player)
			toast(player, "bases_full")
		end,
		signText = function(owner: Player?, _index: number): string
			return if owner then Text.t("base_sign", { player = owner.DisplayName }) else Text.t("base_free")
		end,
	}
	ctx.call("plot.configure", plotHooks)
	local function assign(player: Player, names: { string })
		claimNames[player] = names
		ctx.call("plot.claim", player)
		-- Stats 在 hooks.load 返回之后才把 ready 置位：此刻 canClaim 还说不行，plot 记下了请求；defer 到读档函数走完再补
		task.defer(function()
			if player.Parent then
				ctx.call("plot.ready", player)
			end
		end)
	end
	-- 客户端就绪握手：连上 OnClientEvent 之后告诉服务端，服务端补发「你的基地编号」
	remote.OnServerEvent:Connect(function(player: Player, kind: any)
		if kind == "ready" then
			local bi = baseOf(player)
			if bi then
				remote:FireClient(player, "base", bi)
			end
		end
	end)

	-- ---------- 统计与存档 ----------
	-- 存档：基地名单（"名字" 或 "名字|突变"）、等级、图鉴
	local function saveOf(player: Player)
		local out = table.clone(roster[player] or {})
		for _, n in ipairs(overflow[player] or {}) do
			table.insert(out, n)
		end
		local list = {}
		for k in pairs(seen[player] or {}) do
			table.insert(list, k)
		end
		return { base = out, level = math.max(levelSaved[player] or 1, levelOf[player] or 1), seen = list, speed = speedLv[player] }
	end
	local function onLoad(player: Player, data)
		local names = {}
		if type(data.base) == "table" then
			for _, n in ipairs(data.base) do
				if type(n) == "string" then
					table.insert(names, n)
				end
			end
		end
		roster[player] = names
		levelSaved[player] = if type(data.level) == "number" then math.clamp(math.floor(data.level), 1, 3) else 1
		levelOf[player] = math.min(levelSaved[player], Config.Levels)
		local s = {}
		if type(data.seen) == "table" then
			for _, k in ipairs(data.seen) do
				if type(k) == "string" then
					s[k] = true
				end
			end
		end
		seen[player] = s
		speedLv[player] = if type(data.speed) == "number" then math.clamp(math.floor(data.speed), 0, #(Config.SpeedCosts or {})) else 0
		-- 读档和出生是同时进行的：出生时设的速度还是 0 级，读完再按等级设一次（审查 I2）
		-- （读档时还没在扛东西；carrying 在下面才声明，这里不能用）
		if (speedLv[player] or 0) > 0 then
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = WALK + speedLv[player] * (Config.SpeedStep or 0) + (if type(player:GetAttribute("PassSpeedBonus")) == "number" then player:GetAttribute("PassSpeedBonus") else 0)
			end
		end
		local list = {}
		for k in pairs(s) do
			table.insert(list, k)
		end
		remote:FireClient(player, "seen", list)
		assign(player, names)
	end
	-- 存档读写接到 declare 登记的字段上；读档早于 start 的玩家现在补
	saveRef = saveOf
	loadRef = onLoad
	for player in pairs(pending) do
		pending[player] = nil
		local data = raw[player] or {}
		raw[player] = nil
		if player.Parent then
			task.defer(onLoad, player, data)
		end
	end

	-- 散落局：场地台子空出来之后什么时候刷新（台子序号 → 时间）
	local wildRespawnAt: { [number]: number } = {}

	-- 正扛着偷来的角色的玩家
	type Carry = { owned: Owned, from: Base }
	local carrying: { [Player]: Carry } = {}

	-- ---------- 跑道 ----------
	type Walker = { model: Model, root: BasePart, rootLocal: CFrame, t0: number, name: string, sold: boolean, mut: string? }
	local walkers: { Walker } = {}

	local ORDER = { "common", "rare", "epic", "legendary", "mythic" }
	local function pick(): string
		local present, total = {}, 0
		for _, r in ipairs(ORDER) do
			local list = {}
			for _, c in ipairs(Config.Creatures) do
				if c.Rarity == r then
					table.insert(list, c.Name)
				end
			end
			if #list > 0 then
				local w = weightOf(r)
				table.insert(present, { list, w })
				total += w
			end
		end
		local roll = math.random() * total
		for _, x in ipairs(present) do
			roll -= x[2]
			if roll < 0 then
				return x[1][math.random(1, #x[1])]
			end
		end
		local last = present[#present][1]
		return last[math.random(1, #last)]
	end

	local function runwayFoot(a: number): CFrame
		local p = Config.RunwayStart:Lerp(Config.RunwayEnd, a)
		-- 模板面朝 -Z，转成面朝 +X（往前走的方向）
		return CFrame.new(p) * CFrame.Angles(0, -math.pi / 2, 0)
	end

	-- 服务端距离校验（提示本身有距离限制，但外挂可以直接触发）
	local function near(player: Player, part: BasePart, max: number): boolean
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		return hrp ~= nil and (hrp.Position - part.Position).Magnitude <= max
	end
	-- 同一层：楼上的人不能隔着楼板偷 / 卖楼下的（审查 M2；每层高 10）
	local function sameFloor(player: Player, part: BasePart): boolean
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		return hrp ~= nil and math.abs(hrp.Position.Y - part.Position.Y) < 6
	end

	local function freeCount(b: Base): number
		local n = 0
		for k = 1, openSlots(b) do
			if not b.creatures[k] then
				n += 1
			end
		end
		return n
	end

	local function buy(player: Player, w: Walker)
		if w.sold or not w.model.Parent then
			toast(player, "gone")
			return
		end
		if not near(player, w.root, 16) then
			return
		end
		local bi = baseOf(player)
		local b = bi and bases[bi]
		if not b then
			toast(player, "bases_full")
			return
		end
		local k = freeSlot(b)
		-- 扛着偷来的：最后一格要留给它（否则扛回家也放不下，审查 I4）
		if not k or (carrying[player] and freeCount(b) <= 1) then
			toast(player, "base_full")
			return
		end
		local c = byName[w.name]
		local price = c.Price * mult(w.mut)
		local have = Stats.get(player, "cash")
		if have < price then
			toast(player, "need_more", { n = price - have }, "danger")
			return
		end
		w.sold = true
		Stats.add(player, "cash", -price)
		-- 先占住位置（走回去的路上别人买的不能占同一格），走到了再放下
		-- 占位也进存档名单：付了钱 2 秒内离开也不会钱货两空（审查 I2）
		local reserved: Owned = { name = w.name, model = w.model, root = w.root, rootLocal = w.rootLocal, slot = k, base = b.index, stolenBy = nil, mut = w.mut }
		b.creatures[k] = reserved
		remember(b)
		local from = w.root.Position
		local to = slotFoot(b, k) * w.rootLocal
		local prompt0 = w.root:FindFirstChild("BuyPrompt")
		if prompt0 then
			prompt0:Destroy()
		end
		toast(player, "bought", { name = shownName(w.name, w.mut) })
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < 2 and w.model.Parent do
				local a = (os.clock() - t0) / 2
				w.root.CFrame = CFrame.new(from:Lerp(to.Position, a)) * (to - to.Position)
				task.wait()
			end
			w.model:Destroy()
			-- 只动自己占的那一格：买的人走了、基地分给了别人时，这一格可能已经是别人的（审查 I2）
			if b.creatures[k] ~= reserved then
				return
			end
			b.creatures[k] = nil
			if ownerOf(b) == player then
				place(b, k, w.name, w.mut)
			end
		end)
	end

	local function spawnWalker()
		local name = pick()
		local mut = rollMutation()
		local m, root, rootLocal = spawnModel(name, nil, mut)
		if not m then
			return
		end
		local c = byName[name]
		local w: Walker = { model = m, root = root :: BasePart, rootLocal = rootLocal :: CFrame, t0 = os.clock(), name = name, sold = false, mut = mut }
		spawnAt(m, w.root, w.rootLocal, runwayFoot(0))
		local shown = shownName(name, mut)
		local bp = prompt(w.root, "BuyPrompt", Text.t("buy"), shown .. "  " .. Text.t("price", vars({ n = c.Price * mult(mut) })), 0)
		bp.Triggered:Connect(function(player)
			buy(player, w)
		end)
		m.Parent = runwayFolder
		table.insert(walkers, w)
	end

	-- ---------- 转盘 / 种子摊（跑道之外的两种来源） ----------
	local hubFolder = workspace:FindFirstChild("Hub")
	local hubBody = hubFolder and hubFolder:FindFirstChild("HubBody")
	if Config.Source ~= "runway" and hubBody and hubBody:IsA("BasePart") then
		-- 转盘：轮子上的零件焊到轴心，只转轴心
		local center, center0
		local wheel = hubFolder:FindFirstChild("HubWheel")
		if wheel then
			center = wheel:FindFirstChild("WheelCenter")
			if center then
				center0 = center.CFrame
				for _, d in ipairs(wheel:GetDescendants()) do
					if d:IsA("BasePart") and d ~= center then
						d.Anchored = false
						d.Massless = true
						local w = Instance.new("WeldConstraint")
						w.Part0 = center
						w.Part1 = d
						w.Parent = d
					end
				end
			end
		end
		-- 转盘转到的总角度（接着上一次转，不跳回原位）；动画令牌：新的一次接管画面，旧的照样按时发结果
		local wheelAngle = 0
		local animToken = 0
		local segments = Config.WheelSegments or {}
		-- 停下时让指针（正上方，π/2）落在抽中那档的某个扇区上（审查 I5：原来停哪和结果无关）
		local function targetAngle(rarity: string): number
			local ks = {}
			for k, r in ipairs(segments) do
				if r == rarity then
					table.insert(ks, k)
				end
			end
			local k = if #ks > 0 then ks[math.random(1, #ks)] else 1
			local a = (k - 1) / math.max(1, #segments) * math.pi * 2
			local want = (math.pi / 2 - a) % (math.pi * 2)
			local now0 = wheelAngle % (math.pi * 2)
			return wheelAngle + (4 + math.random(0, 1)) * math.pi * 2 + (want - now0) % (math.pi * 2)
		end
		local actionKey = if Config.Source == "spin" then "spin" else "seeds"
		Text.billboard(hubBody, table.concat({ Text.t(actionKey), Text.t("price", vars({ n = Config.RollCost })) }, "\n"), Color3.fromRGB(255, 214, 90)).StudsOffset = Vector3.new(0, 4, 0)
		local pp = prompt(hubBody, "HubPrompt", Text.t(actionKey), Text.t("price", vars({ n = Config.RollCost })), 0)
		pp.MaxActivationDistance = 12
		pp.Triggered:Connect(function(player)
			if not near(player, hubBody, 16) then
				return
			end
			local bi = baseOf(player)
			local b = bi and bases[bi]
			if not b then
				toast(player, "bases_full")
				return
			end
			local k = freeSlot(b)
			-- 扛着偷来的：最后一格留给它（与跑道买的规则一样）
			if not k or (carrying[player] and freeCount(b) <= 1) then
				toast(player, "base_full")
				return
			end
			local have = Stats.get(player, "cash")
			if have < Config.RollCost then
				toast(player, "need_more", { n = Config.RollCost - have }, "danger")
				return
			end
			Stats.add(player, "cash", -Config.RollCost)
			local name = pick()
			local mut = rollMutation()
			if Config.Source == "garden" then
				if not plant(b, k, name, player, mut) then
					Stats.add(player, "cash", Config.RollCost) -- 种不下去（模板缺失）：退钱
				end
				return
			end
			-- 转盘：先占住这一格（占位不生钱、不能偷、不能卖），转 2.5 秒再放；大家可以同时转（审查 I6：原来全服一把锁）
			local reserved: Owned = { name = name, model = Instance.new("Model"), root = hubBody, rootLocal = CFrame.new(), slot = k, base = b.index, stolenBy = nil, readyAt = now() + 3, mut = mut }
			b.creatures[k] = reserved
			remember(b)
			local c = byName[name]
			animToken += 1
			local mine = animToken
			local from = wheelAngle
			local to = targetAngle(c.Rarity)
			wheelAngle = to
			task.spawn(function()
				local t0 = os.clock()
				while os.clock() - t0 < 2.5 do
					if center and animToken == mine then
						local a = (os.clock() - t0) / 2.5
						local eased = 1 - (1 - a) ^ 3
						center.CFrame = CFrame.new(center0.Position) * CFrame.Angles(0, 0, from + (to - from) * eased) * (center0 - center0.Position)
					end
					task.wait()
				end
				if b.creatures[k] == reserved then
					b.creatures[k] = nil
					if ownerOf(b) == player then
						if place(b, k, name, mut) then
							local rk = "rarity_" .. c.Rarity -- internal
							local shown = shownName(name, mut)
							toast(player, "rolled", { name = shown .. " (" .. Text.t(rk) .. ")" })
						else
							Stats.add(player, "cash", Config.RollCost) -- 放不下去（模板缺失）：退钱
						end
					end
				end
			end)
		end)
	end

	-- ---------- 偷 ----------

	local function walkOf(player: Player): number
		return WALK + (speedLv[player] or 0) * (Config.SpeedStep or 0)
	end
	-- 扛着时的速度：越稀有越重（散落局）；升级的跑速对扛着也有效
	local function carryOf(player: Player, name: string): number
		local c = byName[name]
		local w = (Config.CarryWeight and c and Config.CarryWeight[c.Rarity]) or 1
		return (Config.CarrySpeed + (speedLv[player] or 0) * (Config.SpeedStep or 0)) * w
	end

	local function speed(player: Player, walk: number)
		local ch = player.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum then
			-- Robux 商店的加速通行证（PassSpeedBonus）照样算上
			hum.WalkSpeed = walk + (if type(player:GetAttribute("PassSpeedBonus")) == "number" then player:GetAttribute("PassSpeedBonus") else 0)
		end
	end

	-- 送回原位（被碰到 / 死了 / 离开）
	local function giveBack(thief: Player, why: string?)
		local cr = carrying[thief]
		if not cr then
			return
		end
		carrying[thief] = nil
		thief:SetAttribute("Carrying", nil) -- internal
		speed(thief, walkOf(thief))
		local o = cr.owned
		o.stolenBy = nil
		local weld = o.root:FindFirstChild("CarryWeld")
		if weld then
			weld:Destroy()
		end
		local sp = o.root:FindFirstChild("StealPrompt")
		if sp then
			sp.Enabled = true
		end
		if cr.from.creatures[o.slot] == o then
			if o.model.Parent and o.root.Parent then
				o.root.Anchored = true
				footTo(o.root, o.rootLocal, slotFoot(cr.from, o.slot))
			else
				-- 扛着掉出地图被引擎销毁了：原格放一只新的（否则格子被一个看不见的「幽灵」永久占住，审查 I1）
				unplace(cr.from, o)
				if ownerOf(cr.from) then
					place(cr.from, o.slot, o.name, o.mut)
				end
			end
		else
			o.model:Destroy()
		end
		label(cr.from)
		if why and thief.Parent then
			toast(thief, why, { name = shownName(o.name, o.mut) }, "danger")
		end
		if ownerOf(cr.from) and ownerOf(cr.from).Parent then
			toast(ownerOf(cr.from), "returned", { name = shownName(o.name, o.mut) })
		end
	end

	function stealCreature(thief: Player, b: Base, o: Owned)
		if (not Config.Stealing and not b.wild) or ownerOf(b) == thief or o.stolenBy or o.readyAt or b.creatures[o.slot] ~= o then
			return
		end
		if not near(thief, o.root, 14) or not sameFloor(thief, o.root) then
			return
		end
		if now() < b.lockedUntil then
			toast(thief, "base_locked", nil, "danger")
			return
		end
		if carrying[thief] then
			toast(thief, "carrying")
			return
		end
		local mine = baseOf(thief) and bases[baseOf(thief)]
		if not mine or not freeSlot(mine) then
			toast(thief, "base_full")
			return
		end
		local hrp = thief.Character and thief.Character:FindFirstChild("HumanoidRootPart") :: BasePart
		if not hrp then
			return
		end
		o.stolenBy = thief
		carrying[thief] = { owned = o, from = b }
		thief:SetAttribute("Carrying", o.name) -- internal
		local sp = o.root:FindFirstChild("StealPrompt")
		if sp then
			sp.Enabled = false
		end
		-- 扛在头上：解锚后焊到玩家身上（Massless，不拖慢人）
		o.root.Anchored = false
		o.root.CFrame = hrp.CFrame * CFrame.new(0, 4 + o.root.Size.Y / 2, 0)
		local w = Instance.new("WeldConstraint")
		w.Name = "CarryWeld"
		w.Part0 = hrp
		w.Part1 = o.root
		w.Parent = o.root
		speed(thief, carryOf(thief, o.name))
		label(b)
		toast(thief, if b.wild then "wild_grabbed" else "stealing", { name = shownName(o.name, o.mut) })
		if ownerOf(b) then
			toast(ownerOf(b), "robbed", { player = thief.DisplayName, name = shownName(o.name, o.mut) }, "danger")
		end
	end

	-- 扛进自己基地：归你
	local function arrive(thief: Player, mine: Base)
		local cr = carrying[thief]
		if not cr then
			return
		end
		local k = freeSlot(mine)
		if not k then
			-- 扛回家却没空位：送回去并说清楚，不让人一直扛着站在家里（审查 I4）
			giveBack(thief, "base_full")
			return
		end
		carrying[thief] = nil
		thief:SetAttribute("Carrying", nil) -- internal
		speed(thief, walkOf(thief))
		local o = cr.owned
		unplace(cr.from, o)
		o.model:Destroy()
		place(mine, k, o.name, o.mut)
		if cr.from.wild then
			wildRespawnAt[o.slot] = now() + (Config.WildRespawnSeconds or 20)
		end
		Stats.add(thief, "steals", 1)
		toast(thief, "stolen", { name = shownName(o.name, o.mut) })
		if ownerOf(cr.from) and ownerOf(cr.from).Parent then
			toast(ownerOf(cr.from), "lost", { player = thief.DisplayName, name = shownName(o.name, o.mut) }, "danger")
		end
	end

	function sellCreature(player: Player, b: Base, o: Owned)
		if ownerOf(b) ~= player or o.stolenBy or o.readyAt or b.creatures[o.slot] ~= o or not near(player, o.root, 14) or not sameFloor(player, o.root) then
			return
		end
		local c = byName[o.name]
		local n = sellValue(c, o.mut)
		unplace(b, o)
		o.model:Destroy()
		Stats.add(player, "cash", n)
		toast(player, "sold", { name = shownName(o.name, o.mut), n = n })
	end

	-- ---------- 收钱垫、锁基地 ----------
	for _, b in ipairs(bases) do
		local pad = b.model:FindFirstChild("CollectPad") :: BasePart
		local bb = Instance.new("BillboardGui")
		bb.Name = "PendingGui"
		bb.Size = UDim2.fromOffset(160, 40)
		bb.StudsOffset = Vector3.new(0, 2.5, 0)
		bb.MaxDistance = 60
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.TextScaled = true
		l.Font = Text.font
		l.TextColor3 = Color3.fromRGB(255, 214, 90)
		l.TextStrokeTransparency = 0.3
		l.Text = ""
		l.Parent = bb
		bb.Parent = pad
		pad.Touched:Connect(function(hit)
			local p = Players:GetPlayerFromCharacter(hit.Parent)
			if p and ownerOf(b) == p and b.pending >= 1 and Stats.ready(p) then
				local n = math.floor(b.pending)
				b.pending -= n
				Stats.add(p, "cash", n)
				toast(p, "collected", { n = n })
				label(b)
			end
		end)
		-- 不能偷的变体没有锁垫
		local lock = b.model:FindFirstChild("LockPad") :: BasePart
		if lock then
			Text.billboard(lock, Text.t("lock"), Color3.fromRGB(140, 190, 255)).Name = "LockGui"
			lock.Touched:Connect(function(hit)
				local p = Players:GetPlayerFromCharacter(hit.Parent)
				if p and ownerOf(b) == p and now() >= b.lockReadyAt then
					b.lockedUntil = now() + Config.LockSeconds
					b.lockReadyAt = now() + Config.LockCooldown
					local door = b.model:FindFirstChild("LaserDoor")
					if door then
						door.Transparency = 0.35
					end
					label(b)
				end
			end)
		end
		-- 主人牌（BaseSign 上的名字 + 头像）由 plot 积木建和画
		-- 升级台：按住 E 升一层（只给主人看，客户端另外藏起别人的）
		local station = b.model:FindFirstChild("UpgradeStation") :: BasePart?
		if station then
			local ug = Text.billboard(station, "", Color3.fromRGB(255, 214, 90))
			ug.Name = "UpgradeGui"
			ug.Size = UDim2.fromOffset(200, 48)
			ug.StudsOffset = Vector3.new(0, 3.5, 0)
			local up = prompt(station, "UpgradePrompt", Text.t("upgrade_action"), "", 1)
			-- 只有基地主人、站在升级台旁才升得了（审查：非主人的升级请求被拒；单独成函数，QA 钩子拿它直接试别人的基地）
			local function tryUpgrade(player: Player)
				if ownerOf(b) ~= player or not near(player, station, 14) then
					return
				end
				local cost = Config.LevelCosts[b.level + 1]
				if not cost then
					return
				end
				local have = Stats.get(player, "cash")
				if have < cost then
					toast(player, "need_more", { n = cost - have }, "danger")
					return
				end
				Stats.add(player, "cash", -cost)
				levelOf[player] = b.level + 1
				levelSaved[player] = math.max(levelSaved[player] or 1, b.level + 1)
				setLevel(b, b.level + 1)
				toast(player, "upgraded", { n = b.level })
			end
			upgradeOf[b] = tryUpgrade
			up.Triggered:Connect(tryUpgrade)
		end
		label(b)
	end

	-- 基地的主人走了（plot.release 把基地空出来之后、给排队的人之前调到这里）：别人正扛着的、基地里的角色都没了，基地回到 1 层
	plotHooks.onReleased = function(_player: Player, _plotId: number, part: Instance)
		local b = baseByModel[part]
		if not b then
			return
		end
		-- 别人正扛着他基地里的：直接没了（主人走了，基地要让出去）
		for thief, cr in pairs(carrying) do
			if cr.from == b then
				carrying[thief] = nil
				thief:SetAttribute("Carrying", nil) -- internal
				speed(thief, walkOf(thief))
				cr.owned.model:Destroy()
			end
		end
		for _, o in pairs(b.creatures) do
			o.model:Destroy()
		end
		b.creatures = {}
		b.pending = 0
		b.lockedUntil = 0
		setLevel(b, 1)
		local door = b.model:FindFirstChild("LaserDoor")
		if door then
			door.Transparency = 1
		end
		label(b)
	end

	-- 玩家离开：他扛着的送回去；他的基地清空、让给排队的人（顺序要定死：先送回去，再空基地，所以 plot 积木设了 AutoRelease = 0，由这里调 release）
	Players.PlayerRemoving:Connect(function(player)
		giveBack(player)
		claimNames[player] = nil
		ctx.call("plot.release", player)
		-- Stats 在它自己的 PlayerRemoving 里存档（dump 读 roster）；晚一点再清 roster
		task.delay(30, function()
			if not player.Parent then
				roster[player] = nil
				overflow[player] = nil
				levelOf[player] = nil
				levelSaved[player] = nil
				seen[player] = nil
				speedLv[player] = nil
			end
		end)
	end)

	-- ---------- 散落 + 守卫（wild：东西在各区域的台子上，拿起扛回基地；守卫追扛着东西的人） ----------
	local wildFolder = workspace:FindFirstChild("Wild")
	local wildBase: Base? = nil
	local guards = {}
	if Config.Source == "wild" and wildFolder then
		local spotsFolder = wildFolder:WaitForChild("Spots")
		local slots = {}
		local tierOf = {}
		for _, sp in ipairs(spotsFolder:GetChildren()) do
			local k = sp:FindFirstChild("Spot")
			local tier = sp:FindFirstChild("Tier")
			if sp:IsA("BasePart") and k and tier then
				slots[k.Value] = sp
				tierOf[k.Value] = tier.Value
			end
		end
		local holder = Instance.new("Folder")
		holder.Name = "WildCreatures"
		holder.Parent = workspace
		local wb: Base = {
			index = 0,
			model = holder :: any,
			floor = spotsFolder:FindFirstChildWhichIsA("BasePart") :: BasePart,
			slots = slots,
			creatures = {},
			pending = 0,
			lockedUntil = 0,
			lockReadyAt = 0,
			inward = 1,
			level = 99,
			wild = true,
		}
		wildBase = wb
		-- 第 tier 片区域刷哪只：这一档的稀有度里按权重抽
		local function pickWild(tier: number): string?
			local rar = Config.WildRarities[tier + 1] or {}
			local list, total = {}, 0
			for _, c in ipairs(Config.Creatures) do
				if table.find(rar, c.Rarity) then
					local w = weightOf(c.Rarity)
					table.insert(list, { c.Name, w })
					total += w
				end
			end
			if #list == 0 then
				return pick()
			end
			local roll = math.random() * total
			for _, x in ipairs(list) do
				roll -= x[2]
				if roll < 0 then
					return x[1]
				end
			end
			return list[#list][1]
		end
		local function refill(k: number)
			local name = pickWild(tierOf[k] or 0)
			if name then
				place(wb, k, name, rollMutation())
			end
		end
		for k in pairs(slots) do
			refill(k)
		end
		task.spawn(function()
			while true do
				task.wait(0.5)
				local t = now()
				for k in pairs(slots) do
					if not wb.creatures[k] and (wildRespawnAt[k] or 0) <= t then
						wildRespawnAt[k] = nil
						refill(k)
					end
				end
			end
		end)

		-- 守卫：预览里摆好的那几个就是守卫（每个记着自己的 Zone），只在自己的区域里走。
		-- 每个守卫一个不转的隐形根零件，其余零件焊上去：每次只挪根零件（审查 I4：原来每帧 PivotTo 整个模型）
		local pv = workspace:FindFirstChild("PreviewGuards")
		if pv then
			local live = Instance.new("Folder")
			live.Name = "Guards"
			live.Parent = workspace
			for _, g in ipairs(pv:GetChildren()) do
				local zi = g:FindFirstChild("Zone")
				local zone = zi and Config.WildZones[zi.Value]
				if g:IsA("Model") and zone then
					local box = g:GetBoundingBox()
					local root = Instance.new("Part")
					root.Name = "GuardRoot"
					root.Size = Vector3.new(2, 2, 2)
					root.Transparency = 1
					root.CanCollide = false
					root.CanQuery = false
					root.Anchored = true
					root.CFrame = CFrame.new(box.Position)
					root.Parent = g
					for _, d in ipairs(g:GetDescendants()) do
						if d:IsA("BasePart") and d ~= root then
							d.Anchored = false
							d.CanCollide = false
							d.Massless = true
							local w = Instance.new("WeldConstraint")
							w.Part0 = root
							w.Part1 = d
							w.Parent = d
						end
					end
					g.PrimaryPart = root
					g.Parent = live
					table.insert(guards, {
						root = root,
						pos = Vector3.new(box.Position.X, 0, box.Position.Z),
						y = box.Position.Y,
						zone = zone,
						speed = Config.GuardSpeeds[zone.Tier + 1] or Config.GuardSpeed,
						goal = nil,
						face = nil,
					})
				end
			end
			pv:Destroy()
		end
		local function inZone(z, v: Vector3, pad: number): boolean
			return v.X >= math.min(z.X0, z.X1) - pad and v.X <= math.max(z.X0, z.X1) + pad and v.Z >= z.Z0 - pad and v.Z <= z.Z1 + pad
		end
		-- 贴着区域边滑（越界的那个方向夹回去，另一方向照走），不在边上原地停住让人放风筝
		local function clampZone(z, v: Vector3): Vector3
			return Vector3.new(math.clamp(v.X, math.min(z.X0, z.X1) + 1, math.max(z.X0, z.X1) - 1), 0, math.clamp(v.Z, z.Z0 + 1, z.Z1 - 1))
		end
		local function randomIn(z): Vector3
			local x0, x1 = math.min(z.X0, z.X1) + 4, math.max(z.X0, z.X1) - 4
			return Vector3.new(x0 + math.random() * (x1 - x0), 0, z.Z0 + 6 + math.random() * (z.Z1 - z.Z0 - 12))
		end
		local acc = 0
		RunService.Heartbeat:Connect(function(dt0)
			-- 约 20 次 / 秒就够
			acc += dt0
			if acc < 0.05 then
				return
			end
			local dt = acc
			acc = 0
			for _, g in ipairs(guards) do
				-- 追：区域里（边上留 2 格）、追得到范围内、扛着东西的人里最近的那个
				local target, best = nil, Config.GuardChaseRange
				for thief in pairs(carrying) do
					local hrp = thief.Character and thief.Character:FindFirstChild("HumanoidRootPart")
					if hrp and inZone(g.zone, hrp.Position, 2) then
						local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - g.pos).Magnitude
						if d < best then
							target, best = thief, d
						end
					end
				end
				local goal: Vector3
				local sp = g.speed
				if target then
					local hrp = (target :: Player).Character.HumanoidRootPart
					goal = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
					if best <= Config.GuardCatchRange then
						giveBack(target :: Player, "wild_caught")
					end
				else
					-- 巡逻：走到一个随机点再换一个（巡逻慢一点）
					if not g.goal or (g.goal - g.pos).Magnitude < 2 then
						g.goal = randomIn(g.zone)
					end
					goal = g.goal
					sp *= 0.5
				end
				local dir = goal - g.pos
				local len = dir.Magnitude
				if len > 0.05 then
					g.pos = clampZone(g.zone, g.pos + dir.Unit * math.min(len, sp * dt))
					g.root.CFrame = CFrame.lookAt(Vector3.new(g.pos.X, g.y, g.pos.Z), Vector3.new(goal.X, g.y, goal.Z))
				end
			end
		end)

		-- 跑速台：按住 E 花钱升一级（走路和扛着都更快），等级存档
		local stand = wildFolder:FindFirstChild("SpeedStand")
		if stand and stand:IsA("BasePart") then
			local sp = prompt(stand, "SpeedPrompt", Text.t("wild_speed"), "", 0.5)
			sp.Triggered:Connect(function(player)
				-- 存档还没读完时不卖（读完会把等级盖掉，审查 I2）
				if not Stats.ready(player) or not near(player, stand, 16) then
					return
				end
				local lv = speedLv[player] or 0
				local cost = Config.SpeedCosts[lv + 1]
				if not cost then
					toast(player, "wild_speed_max")
					return
				end
				local have = Stats.get(player, "cash")
				if have < cost then
					toast(player, "need_more", { n = cost - have }, "danger")
					return
				end
				Stats.add(player, "cash", -cost)
				speedLv[player] = lv + 1
				local cr = carrying[player]
				speed(player, if cr then carryOf(player, cr.owned.name) else walkOf(player))
				toast(player, "wild_speed_up", { n = lv + 1 })
			end)
		end
		-- 重生 / 进服：按跑速等级设走路速度；进服说一句怎么玩
		local function onChar(player: Player)
			player.CharacterAdded:Connect(function()
				task.wait(0.2)
				speed(player, walkOf(player))
			end)
		end
		for _, p in ipairs(Players:GetPlayers()) do
			onChar(p)
		end
		Players.PlayerAdded:Connect(function(p)
			onChar(p)
			task.delay(4, function()
				if p.Parent then
					toast(p, "wild_intro")
				end
			end)
		end)
	end

	-- ---------- 主循环 ----------
	local lastSpawn = 0
	local lastIncome = os.clock()
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		-- 跑道：走完就消失
		for i = #walkers, 1, -1 do
			local w = walkers[i]
			if w.sold or not w.model.Parent then
				table.remove(walkers, i)
			else
				local a = (t - w.t0) / Config.RunwaySeconds
				if a >= 1 then
					w.model:Destroy()
					table.remove(walkers, i)
				else
					footTo(w.root, w.rootLocal, runwayFoot(a))
				end
			end
		end
		-- 只有跑道模式刷跑道上的角色（转盘 / 种菜从中间的机器来）
		if Config.Source == "runway" and t - lastSpawn >= Config.SpawnSeconds then
			lastSpawn = t
			spawnWalker()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.2)
			local t = os.clock()
			local dt = t - lastIncome
			lastIncome = t
			for _, b in ipairs(bases) do
				if ownerOf(b) then
					b.pending += income(b) * dt
				end
				-- 锁着的基地：别人进来就推到门外
				local locked = now() < b.lockedUntil
				local door = b.model:FindFirstChild("LaserDoor")
				if door then
					door.Transparency = if locked then 0.35 else 1
				end
				if locked then
					for _, p in ipairs(Players:GetPlayers()) do
						local hrp = p ~= ownerOf(b) and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
						if hrp and inside(b, hrp.Position) then
							local out = b.floor.Position + Vector3.new(0, 3, -b.inward * (b.floor.Size.Z / 2 + 5))
							p.Character:PivotTo(CFrame.new(out))
							toast(p, "base_locked", nil, "danger")
						end
					end
				end
			end
			-- 扛着的：进自己基地就归你；被主人碰到 / 死了就送回去
			for thief, cr in pairs(carrying) do
				local ch = thief.Character
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				-- 死了、掉出地图（掉到 -30 以下就当死了）
				if not hum or hum.Health <= 0 or not hrp or hrp.Position.Y < -30 then
					giveBack(thief)
				else
					local owner = ownerOf(cr.from)
					local oh = owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
					if oh and (oh.Position - hrp.Position).Magnitude < 5 then
						giveBack(thief, "tagged")
					else
						local mine = baseOf(thief) and bases[baseOf(thief)]
						if mine and inside(mine, hrp.Position) then
							arrive(thief, mine)
						end
					end
				end
			end
		end
	end)

	-- 突变风暴：每 MutationEventSeconds 一次，持续 MutationStormSeconds（0 / 没开突变 = 不刮）
	if (Config.MutationEventSeconds or 0) > 0 and #(Config.Mutations or {}) > 0 then
		task.spawn(function()
			while true do
				task.wait(Config.MutationEventSeconds)
				stormUntil = now() + Config.MutationStormSeconds
				workspace:SetAttribute("MutationStormUntil", stormUntil) -- internal
				for _, p in ipairs(Players:GetPlayers()) do
					toast(p, "storm_start", { t = fmtTime(Config.MutationStormSeconds) })
				end
				task.wait(Config.MutationStormSeconds)
				for _, p in ipairs(Players:GetPlayers()) do
					toast(p, "storm_end")
				end
			end
		end)
	end

	-- 基地收钱牌与锁的倒计时每秒刷一次
	task.spawn(function()
		while true do
			task.wait(1)
			for _, b in ipairs(bases) do
				label(b)
			end
		end
	end)
end

return Core
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX0000000000000000000000000000134C">
			<Properties>
				<string name="Name">README</string>
				<ProtectedString name="Source"><![CDATA[--[==[
	محاكي صيد الحيوانات
	Made with LevelShaper — the AI Roblox game maker (https://levelshaper.com)

	HOW TO PLAY-TEST
	  Press F5 (or the Play button) in Roblox Studio.

	HOW TO PUBLISH
	  File > Publish to Roblox, then set the game to Public in Creator Dashboard.
	  Upload the thumbnail and icon from LevelShaper on the game's Configure page.

	HOW TO CUSTOMIZE
	  ReplicatedStorage > GameConfig holds every name, price and number.
	  Everything in Workspace is normal Parts — move, recolor or delete freely.
	  Names, prices, income and rarity weights live in GameConfig.Creatures / Rarity.
	  Character models are in ServerStorage.StealCreatures (one Model per GameConfig.Creatures entry, by Template).
	  Bases are identical: each has Slots, a CollectPad, a LockPad and a LaserDoor.
	  Which base a player gets (the first free one, a waiting line when all are taken, freed when the owner leaves) is the plot block (Blocks/plot); a base and its BaseSign carry BlockRole = plot / plot_sign.

	Tip: turn on Game Settings > Security > Enable Studio Access to API Services
	so player progress saves while you test in Studio.

	WHERE THINGS ARE
	  ReplicatedStorage > GameConfig: names, prices and numbers for the whole game (each field has a note above it)
	  ReplicatedStorage > LevelShaperText: shared helper that fills in the texts from GameConfig.Strings
	  ServerScriptService > StealServer: Blocks boot: starts the blocks of this game's recipe in dependency order.
	  ServerScriptService > LevelShaperModules: shared save, leaderboard stats and helpers
	  ServerScriptService > SceneServer: Scene: sign text and NPC name tags in the spawn plaza.
	  StarterPlayerScripts > StealHUD: Steal (client): cash / income HUD, lock timer, toasts, and which prompts you see
	  Workspace: Lobby, Wild, PreviewGuards, Bases, PreviewCreatures, Decor, Scene, World, Builds, Props (normal Parts: move or recolor freely; the scripts find these folders by name, so keep them)
]==]
return nil]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000000000000000000000000134D">
			<Properties>
				<string name="Name">SceneServer</string>
				<ProtectedString name="Source"><![CDATA[-- LevelShaper Scene: sign text and NPC name tags in the spawn plaza.
-- Change a sign by editing the Label value under it; change an NPC's name with its NpcName value.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Text = require(ReplicatedStorage:WaitForChild("LevelShaperText"))
local roots = { workspace:WaitForChild("Scene") }
-- obby 多路线的起点拱门（路线名）
local obby = workspace:FindFirstChild("Obby")
local gates = obby and obby:FindFirstChild("CourseGates")
if gates then
	table.insert(roots, gates)
end

local all = {}
for _, root in ipairs(roots) do
	for _, d in ipairs(root:GetDescendants()) do
		table.insert(all, d)
	end
end
for _, d in ipairs(all) do
	local host = d.Parent
	if d:IsA("StringValue") and host and host:IsA("BasePart") and d.Value ~= "" then
		if d.Name == "Label" then
			Text.surface(host, d.Value)
		elseif d.Name == "NpcName" then
			local bb = Text.billboard(host, d.Value, Color3.fromRGB(255, 230, 140))
			bb.StudsOffset = Vector3.new(0, 3.5, 0)
			bb.MaxDistance = 60
		end
	end
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
			</Properties>
